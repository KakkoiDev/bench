#!/bin/sh
# bench - Minimal benchmarking CLI
# POSIX-compliant shell script (dash-compatible)
#
# =============================================================================
# IMPLEMENTATION NOTES
# =============================================================================
#
# Why POSIX shell?
#   - Runs on any Unix system without bash dependency
#   - dash-compatible for faster execution on Debian/Ubuntu
#   - No bashisms: arrays, [[ ]], etc. avoided intentionally
#
# Why Perl for timing?
#   - POSIX date(1) doesn't support sub-second precision
#   - Perl's Time::HiRes gives microsecond accuracy (6 decimal places)
#   - Available on virtually all Unix systems
#   - Alternatives considered:
#     * GNU date %N: not portable (BSD/macOS lack it)
#     * Python: slower startup, heavier dependency
#     * /proc/uptime: Linux-only
#
# Why bc for math?
#   - POSIX shell has no floating-point arithmetic
#   - bc is standard on Unix systems (POSIX.1-2001)
#   - Used for: timing calculations, statistics, memory conversions
#
# Why ps for process stats?
#   - Portable across Unix systems (Linux, macOS, BSD)
#   - /proc filesystem is Linux-only
#   - Alternative tools (top, pidstat) have inconsistent interfaces
#
# Why this JSON format?
#   - Self-documenting: units included in each section (e.g., "unit": "milliseconds")
#   - AI-friendly: structured data for LLM analysis
#   - jq-friendly: easy querying with standard tools
#   - Schema versioned: allows tooling to adapt to format changes
#
# For function-level implementation details, see comments throughout the code.
# For manual testing procedures, see MANUAL-TESTING.md
#
# =============================================================================

set -e

VERSION="3.0.0"
SCHEMA_VERSION="2.1"

# Global state for signal handling
INTERRUPTED=0
RUNS_COMPLETED=0
OUTPUT_DIR=""

# Resources released by cleanup() on exit (see trap below)
SAMPLER_PID=""
TIMES_FILE=""
EXIT_CODES_FILE=""
RUNS_FILE=""
MEASUREMENTS_FILE=""
# The four accumulators above are rebound per variant by select_variant, so
# cleanup tracks the originally created paths separately rather than whichever
# variant happened to be selected last.
BASE_TEMP_FILES=""
INGEST_PL=""
AGGREGATE_PL=""
PROVENANCE_PL=""
RESUME_PL=""
MANIFEST_PL=""
COMPARE_PL=""
SCHEDULE_FILE=""
VARIANT_WORK=""
VARIANT_NAMES=""
CURRENT_VARIANT=""
MULTI_VARIANT=0
VARIANT_DONE_FILE=""
VARIANT_ENV_FILE=""
VARIANT_ERR_FILE=""
MANIFEST_PATH=""
MANIFEST_CONSTRAINTS=""
MANIFEST_ARTIFACTS=""
MANIFEST_VARIANTS=""
MANIFEST_ENV_DIR=""
REQUIRE_FILE=""

# Release resources that would otherwise outlive the script.
#
# Registered on EXIT so that an error, a signal, or a normal exit all reclaim
# the same things: the background metrics sampler (which loops forever and
# would be orphaned) and the mktemp scratch files.
#
# shellcheck disable=SC2317,SC2329
cleanup() {
  if [ -n "$SAMPLER_PID" ]; then
    kill "$SAMPLER_PID" 2>/dev/null || true
    SAMPLER_PID=""
  fi
  if [ -n "$BASE_TEMP_FILES" ]; then
    printf '%s\n' "$BASE_TEMP_FILES" | while IFS= read -r f; do
      [ -n "$f" ] && rm -f "$f"
    done
    BASE_TEMP_FILES=""
  fi
  [ -n "$INGEST_PL" ] && rm -f "$INGEST_PL"
  [ -n "$AGGREGATE_PL" ] && rm -f "$AGGREGATE_PL"
  [ -n "$PROVENANCE_PL" ] && rm -f "$PROVENANCE_PL"
  [ -n "$RESUME_PL" ] && rm -f "$RESUME_PL"
  [ -n "$MANIFEST_PL" ] && rm -f "$MANIFEST_PL"
  [ -n "$COMPARE_PL" ] && rm -f "$COMPARE_PL"
  [ -n "$SCHEDULE_FILE" ] && rm -f "$SCHEDULE_FILE"
  [ -n "$VARIANT_WORK" ] && rm -rf "$VARIANT_WORK"
  [ -n "$VARIANT_ERR_FILE" ] && rm -f "$VARIANT_ERR_FILE"
  [ -n "$MANIFEST_CONSTRAINTS" ] && rm -f "$MANIFEST_CONSTRAINTS"
  [ -n "$MANIFEST_ARTIFACTS" ] && rm -f "$MANIFEST_ARTIFACTS"
  [ -n "$MANIFEST_VARIANTS" ] && rm -f "$MANIFEST_VARIANTS"
  [ -n "$MANIFEST_ENV_DIR" ] && rm -rf "$MANIFEST_ENV_DIR"
  [ -n "$REQUIRE_FILE" ] && rm -f "$REQUIRE_FILE"
  return 0
}
trap 'cleanup' EXIT

# Error handling
error() {
  echo "Error: $1" >&2
  exit 1
}

# Show version
show_version() {
  echo "bench v${VERSION}"
  exit 0
}

# Show help
show_help() {
  cat << 'EOF'
Usage: bench [OPTIONS] COMMAND
       bench run MANIFEST [OPTIONS]
       bench validate MANIFEST
       bench compare BASELINE CANDIDATE [--json] [--seed N] [--require EXPR]
       bench report DIR

Minimal benchmarking CLI - Run commands multiple times and capture structured data.

Subcommands must come first: `bench run exp.yaml --quiet`, not
`bench --quiet run exp.yaml`.

Options:
  --runs N            Number of runs (default: 10)
  --name NAME         Named group for organizing results
  --message TEXT      Describe what changed (e.g., "baseline", "with cache")
  --quiet             Suppress progress output, only print results path

  --pid [NAME:]PID    Monitor process CPU/memory by PID (repeatable)
  --port [NAME:]PORT  Monitor process by port (repeatable)
  --metrics-interval MS  Metrics sampling interval (default: 500, min: 100)

  --evaluate CMD      Independently validate each run; receives the run
                      directory as $1 and in $BENCH_RUN_DIR
  --expect-exit CODE  Exit code the command must return, or "any"
                      (default: 0)
  --require EXPR      Hard constraint on a metric, e.g. "errors == 0"
                      (repeatable)
  --require-artifact PATH
                      Artifact that must exist under the run directory
                      (repeatable)

  --capture-env VAR   Record this environment variable in provenance
                      (repeatable; never captures credential-shaped names)
  --resume DIR        Continue an interrupted benchmark in DIR
  --force-resume      Resume even if the configuration fingerprint differs

  --help              Show help
  --version           Show version

Examples:
  bench --runs 10 "curl localhost:8080"
  bench --runs 20 --name "api-v1" --message "baseline" "curl localhost/api"
  bench --pid 12345 --pid 67890 "curl localhost:8080"
  bench --pid app:12345 --port redis:6379 "curl localhost:8080"
  bench --evaluate ./grade.sh --require "errors == 0" ./run-agent.sh

Evidence protocol:
  Each run gets a directory, exported as $BENCH_RUN_DIR. A command may write:
    $BENCH_RUN_DIR/result.json    {"metrics":{...},"artifacts":[...],"valid":true}
    $BENCH_RUN_DIR/metrics.jsonl  {"type":"metric","name":"tokens","value":1420}
    $BENCH_RUN_DIR/artifacts/     files produced by the run
  Metric values must be finite numbers. A command declaring itself valid does
  not make a run valid; only an evaluator can do that.

Naming:
  Process names may contain letters, digits, '.', '_' and '-'
  (':' is the NAME:PID delimiter). --name must be a single directory
  name: no '/', '.' or '..'.

Output:
  Results saved to: ./bench-results/<name>/<timestamp-pid>/
    - benchmark.json (all metrics)
    - runs/*.log (command stdout/stderr per run)

More info:
  https://github.com/KakkoiDev/bench
  https://github.com/KakkoiDev/bench/issues

EOF
  exit 0
}

# Signal handler for SIGINT/SIGTERM (invoked via trap)
#
# Why simple flag approach?
#   - POSIX signal handling is tricky (async-signal-safe functions only)
#   - Setting a flag is safe; complex logic in handlers is not
#   - Main loop checks INTERRUPTED flag after each run
#   - Ensures partial results are saved before exit
#
# shellcheck disable=SC2317,SC2329
handle_interrupt() {
  INTERRUPTED=1
}

# Get current time in seconds with microsecond precision
# Returns: Unix timestamp as float (e.g., "1702567890.123456")
# Why perl? See IMPLEMENTATION NOTES above. This is the hot path for timing accuracy.
get_time() {
  perl -MTime::HiRes=time -e 'printf "%.6f\n", time()'
}

# Get ISO 8601 timestamp with milliseconds
get_iso_timestamp() {
  perl -MTime::HiRes=gettimeofday -MPOSIX=strftime -e '
    my ($s, $us) = gettimeofday();
    my $ms = int($us / 1000);
    print strftime("%Y-%m-%dT%H:%M:%S", localtime($s)) . sprintf(".%03d", $ms) . "\n";
  '
}

# Normalize bc output to always have leading zero
bc_normalize() {
  echo "$1" | bc | sed 's/^\./0./; s/^-\./-0./'
}

# Escape a string for embedding inside a JSON string literal
#
# Why this matters: every string field in benchmark.json is user-controlled
# (command, message, name, cwd). Without escaping, a command as ordinary as
#   bench 'echo "hello"'
# emits `"command": "echo "hello""` and the whole file fails to parse, which
# defeats the point of a tool whose output is meant to be machine-read.
#
# Why perl? It is already a hard dependency (see check_dependencies), and it
# handles the full escape set - backslash, quote, and the C0 control
# characters that JSON requires as \uXXXX - in a single pass.
#
# Args: $1 = raw string
# Returns: escaped string, safe to place between double quotes
json_escape() {
  printf '%s' "$1" | perl -0777 -pe '
    s/\\/\\\\/g;
    s/"/\\"/g;
    s/\n/\\n/g;
    s/\r/\\r/g;
    s/\t/\\t/g;
    s/([\x00-\x1f])/sprintf("\\u%04x", ord($1))/ge;
  '
}

# Reduce a string to a token safe for use as a filename component,
# a whitespace-delimited list entry, and a JSON object key.
#
# Process names are used in all three roles: they become
# runs/<n>.<name>.metrics, they are stored space-separated in
# MONITOR_PROCESSES, and they key the per-run "processes" object. Anything
# outside [A-Za-z0-9._-] breaks at least one of those, so it is folded to "-".
#
# A leading path is stripped first: macOS `ps -o comm=` reports the full
# executable path, which would otherwise produce an unwritable metrics path.
sanitize_proc_name() {
  printf '%s' "${1##*/}" | tr -c 'A-Za-z0-9._-' '-' | sed 's/-*$//'
}

# Reject a user-supplied process name that cannot be used safely
#
# Auto-detected names are sanitized silently, but a name the user typed is
# rejected outright: silently rewriting "my app" to "my-app" would make the
# --name they chose disagree with the key in benchmark.json.
#
# Args: $1 = name (may be empty, meaning "auto-detect"), $2 = flag for messages
validate_proc_name() {
  [ -z "$1" ] && return 0
  if [ "$1" != "$(sanitize_proc_name "$1")" ]; then
    error "$2 name must contain only letters, digits, '.', '_' or '-' (got: $1)"
  fi
  return 0
}

# Test whether a name is already present in a space-separated list
#
# Why not `grep -w`: -w treats '-' as a word boundary, so "app" matches
# "app-2", and the needle is a regex, so "node.js" matches "nodeXjs". Both
# produce bogus duplicate errors. Pattern matching on padded strings compares
# the whole token literally.
#
# Args: $1 = name, $2 = space-separated list of seen names
name_is_seen() {
  case " $2 " in
    *" $1 "*) return 0 ;;
  esac
  return 1
}

# =============================================================================
# EVIDENCE PROTOCOL (schema 2.1)
# =============================================================================
#
# A benchmarked command, and an optional independent evaluator, may emit
# measurements and register files as evidence. Both write into the per-run
# evidence directory that bench creates and exports as $BENCH_RUN_DIR:
#
#   $BENCH_RUN_DIR/result.json    a single result object
#   $BENCH_RUN_DIR/metrics.jsonl  streaming JSON Lines events
#   $BENCH_RUN_DIR/artifacts/     files the command produced
#
# Neither file is required. A command that writes nothing behaves exactly as
# it did under schema 2.0.
#
# Why files rather than stdout? stdout is the command's own output and is
# preserved verbatim as evidence; multiplexing a control channel onto it
# would corrupt that and break commands that emit binary data.
#
# Why parse with Perl? perl is already a hard dependency, and JSON::PP has
# been core since 5.14. Parsing JSON with sed/grep is how the schema 2.0
# writer produced unparseable output in the first place; an evidence format
# has to be read by a real parser.

# Write the ingest helper to a temp file
#
# Kept as a file rather than an inline `perl -e` string so the Perl source can
# use quotes freely without shell quoting hazards.
write_ingest_helper() {
  INGEST_PL=$(mktemp)
  cat > "$INGEST_PL" << 'INGEST_EOF'
#!/usr/bin/perl
# Read and validate the evidence emitted by one run.
#
# Usage: ingest.pl <result.json> <metrics.jsonl> <label> [<out.json>]
#
# Emits a tab-separated line protocol on stdout for the shell to consume:
#   METRIC   <name> <value> <unit>
#   ARTIFACT <path>
#   EVIDENCE <path>
#   VALID    <0|1>
#   RAW      <canonical JSON of the result object>
#   JSON     <compact evidence object, ready to splice into benchmark.json>
#
# When <out.json> is given, the same evidence object is also written there as
# a standalone, self-describing document.
#
# Validation errors go to stderr, one per line, and exit status is 1.
use strict;
use warnings;
use JSON::PP;

my ($result_path, $jsonl_path, $label, $out_path) = @ARGV;
$label = defined $label ? $label : 'result';

my @errors;
my (%metrics, %units, @order, @artifacts, @evidence);
my $declared_valid;
my $raw = 'null';
my $source;          # the decoded result object, kept verbatim

sub fail { push @errors, $_[0]; }

sub show {
  my ($v) = @_;
  return 'null' unless defined $v;
  return '<object>' if ref $v eq 'HASH';
  return '<array>'  if ref $v eq 'ARRAY';
  return $v ? 'true' : 'false' if JSON::PP::is_bool($v);
  my $s = "$v";
  $s = substr($s, 0, 40) . '...' if length($s) > 43;
  return $s;
}

# Metric names must be stable identifiers: they become JSON object keys and
# are matched across runs, so a name that varies per run is a bug, not data.
sub check_name {
  my ($n) = @_;
  return 0 unless defined $n && !ref $n && length $n;
  return 0 if JSON::PP::is_bool($n);
  return $n =~ /^[A-Za-z_][A-Za-z0-9_.-]*$/ ? 1 : 0;
}

# Values must be finite numbers. JSON itself has no NaN or Infinity literal,
# but 1e999 parses to Inf, so the result is range-checked rather than trusted.
sub check_num {
  my ($v) = @_;
  return undef if !defined $v || ref $v;
  return undef if JSON::PP::is_bool($v);
  return undef unless "$v" =~ /^\s*-?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?\s*$/;
  my $n = $v + 0;
  return undef if $n != $n;                          # NaN
  my $inf = 9**9**9;
  return undef if $n == $inf || $n == -$inf;         # +/- Infinity
  return $n;
}

# Registered paths stay inside the run directory: they are copied, compared
# and shipped as evidence, so absolute paths and traversal are refused.
sub check_path {
  my ($p) = @_;
  return (0, 'must be a non-empty string') unless defined $p && !ref $p && length $p;
  return (0, 'must be a non-empty string') if JSON::PP::is_bool($p);
  return (0, 'must not contain tabs or newlines') if $p =~ /[\t\n\r]/;
  return (0, 'must be relative to the run directory') if $p =~ m{^/};
  return (0, 'must not escape the run directory') if $p =~ m{(?:^|/)\.\.(?:/|$)};
  return (1, '');
}

sub add_metric {
  my ($name, $value, $unit, $where) = @_;
  unless (check_name($name)) {
    fail("$where: invalid metric name " . show($name)
       . " (expected a name matching [A-Za-z_][A-Za-z0-9_.-]*)");
    return;
  }
  my $n = check_num($value);
  unless (defined $n) {
    fail("$where: metric '$name' must be a finite number (got " . show($value) . ")");
    return;
  }
  if (defined $unit && !(ref $unit) && !JSON::PP::is_bool($unit)) {
    unless ($unit =~ m{^[A-Za-z0-9_./%-]{1,32}$}) {
      fail("$where: metric '$name' has an invalid unit " . show($unit));
      return;
    }
    # A metric that changes unit mid-run cannot be aggregated meaningfully
    if (exists $units{$name} && $units{$name} ne $unit) {
      fail("$where: metric '$name' changed unit within the run "
         . "('$units{$name}' then '$unit')");
      return;
    }
    $units{$name} = $unit;
  } elsif (defined $unit) {
    fail("$where: metric '$name' has an invalid unit " . show($unit));
    return;
  }
  push @order, $name unless exists $metrics{$name};
  $metrics{$name} = $n;
}

sub add_path {
  my ($list, $p, $where, $kind) = @_;
  my ($ok, $why) = check_path($p);
  unless ($ok) {
    fail("$where: $kind path " . show($p) . " $why");
    return;
  }
  push @$list, $p unless grep { $_ eq $p } @$list;
}

sub set_valid {
  my ($v, $where) = @_;
  if (JSON::PP::is_bool($v)) { $declared_valid = $v ? 1 : 0; return; }
  fail("$where: 'valid' must be true or false (got " . show($v) . ")");
}

sub slurp {
  my ($path) = @_;
  open my $fh, '<', $path or do { fail("cannot read $path: $!"); return undef; };
  local $/;
  my $txt = <$fh>;
  close $fh;
  return defined $txt ? $txt : '';
}

# ---- result.json: a single object -------------------------------------------
if (defined $result_path && -e $result_path) {
  my $txt = slurp($result_path);
  if (defined $txt && $txt =~ /\S/) {
    my $data = eval { JSON::PP->new->decode($txt) };
    if ($@) {
      my $e = $@; $e =~ s/\s+at\s+\S+\s+line\s+\d+\.?\s*$//s; $e =~ s/\s+/ /g;
      fail("$label: invalid JSON ($e)");
    } elsif (ref $data ne 'HASH') {
      fail("$label: top level must be a JSON object");
    } else {
      # Preserved verbatim so fields this version does not understand survive
      $raw = JSON::PP->new->canonical->encode($data);
      $source = $data;

      if (exists $data->{metrics}) {
        if (ref $data->{metrics} ne 'HASH') {
          fail("$label: 'metrics' must be an object mapping names to numbers");
        } else {
          my $u = $data->{units};
          $u = {} unless ref $u eq 'HASH';
          for my $k (sort keys %{ $data->{metrics} }) {
            add_metric($k, $data->{metrics}{$k}, $u->{$k}, $label);
          }
        }
      }
      for my $pair (['artifacts', \@artifacts], ['evidence', \@evidence]) {
        my ($key, $list) = @$pair;
        next unless exists $data->{$key};
        if (ref $data->{$key} ne 'ARRAY') {
          fail("$label: '$key' must be an array of relative paths");
          next;
        }
        add_path($list, $_, $label, $key) for @{ $data->{$key} };
      }
      set_valid($data->{valid}, $label) if exists $data->{valid};
    }
  }
}

# ---- metrics.jsonl: one event per line --------------------------------------
if (defined $jsonl_path && -e $jsonl_path) {
  if (open my $fh, '<', $jsonl_path) {
    my $ln = 0;
    while (my $line = <$fh>) {
      $ln++;
      next unless $line =~ /\S/;
      my $where = "$label stream line $ln";
      my $ev = eval { JSON::PP->new->decode($line) };
      if ($@) { fail("$where: invalid JSON"); next; }
      if (ref $ev ne 'HASH') { fail("$where: each line must be a JSON object"); next; }
      my $t = $ev->{type};
      if (!defined $t || ref $t) { fail("$where: missing 'type'"); next; }
      if    ($t eq 'metric')   { add_metric($ev->{name}, $ev->{value}, $ev->{unit}, $where); }
      elsif ($t eq 'artifact') { add_path(\@artifacts, $ev->{path}, $where, 'artifact'); }
      elsif ($t eq 'evidence') { add_path(\@evidence,  $ev->{path}, $where, 'evidence'); }
      elsif ($t eq 'valid')    { set_valid($ev->{value}, $where); }
      else { fail("$where: unknown event type '$t' "
                . "(expected metric, artifact, evidence or valid)"); }
    }
    close $fh;
  } else {
    fail("cannot read $jsonl_path: $!");
  }
}

if (@errors) {
  print STDERR "$_\n" for @errors;
  exit 1;
}

for my $n (@order) {
  my $u = defined $units{$n} ? $units{$n} : '';
  print "METRIC\t$n\t$metrics{$n}\t$u\n";
}
print "ARTIFACT\t$_\n" for @artifacts;
print "EVIDENCE\t$_\n" for @evidence;
print "VALID\t$declared_valid\n" if defined $declared_valid;
print "RAW\t$raw\n";

# Numbers are re-encoded from their numeric value so the emitted JSON carries
# real numbers, not the strings they arrived as.
my %m = map { $_ => $metrics{$_} + 0 } keys %metrics;
my $evidence_obj = {
  metrics        => \%m,
  units          => \%units,
  artifacts      => \@artifacts,
  evidence       => \@evidence,
  declared_valid => (defined $declared_valid
                      ? ($declared_valid ? JSON::PP::true : JSON::PP::false)
                      : undef),
};
my $enc = JSON::PP->new->canonical;
print "JSON\t", $enc->encode($evidence_obj), "\n";

if (defined $out_path && length $out_path) {
  # "source" carries the command's original object unchanged, so fields this
  # version of bench does not understand are still readable later.
  my %doc = (%$evidence_obj, schema_version => '2.1', source => $source);
  if (open my $out, '>', $out_path) {
    print $out $enc->pretty->encode(\%doc);
    close $out;
  } else {
    print STDERR "cannot write $out_path: $!\n";
    exit 1;
  }
}
exit 0;
INGEST_EOF
}

# Write the aggregation helper to a temp file
#
# Aggregates raw per-run measurements into per-metric summaries. Kept in Perl
# because it must emit JSON and compute statistics; doing either in shell is
# what this schema exists to stop doing.
write_aggregate_helper() {
  AGGREGATE_PL=$(mktemp)
  cat > "$AGGREGATE_PL" << 'AGG_EOF'
#!/usr/bin/perl
# Summarise raw measurements collected across runs.
#
# Usage: aggregate.pl <measurements.tsv>
#   each line: <run>\t<name>\t<value>\t<unit>
#
# Prints the compact JSON object for the "metrics" field of benchmark.json.
#
# Every observed value is retained under "values". Outliers are never trimmed:
# a summary that silently drops data is not evidence.
use strict;
use warnings;
use JSON::PP;

my ($path) = @ARGV;
my (%vals, %runs, %unit, %valid_vals, @order, @errors);

if (defined $path && -e $path && open my $fh, '<', $path) {
  while (my $line = <$fh>) {
    chomp $line;
    next unless length $line;
    my ($run, $name, $value, $u, $valid) = split /\t/, $line, 5;
    next unless defined $name && defined $value;
    $u = '' unless defined $u;
    push @order, $name unless exists $vals{$name};
    push @{ $vals{$name} }, $value + 0;
    push @{ $runs{$name} }, $run + 0;
    push @{ $valid_vals{$name} }, $value + 0 if defined $valid && $valid eq '1';
    if (length $u) {
      # A unit that disagrees between runs makes the values incomparable
      if (exists $unit{$name} && $unit{$name} ne $u) {
        push @errors, "metric '$name' has inconsistent units across runs "
                    . "('$unit{$name}' and '$u')";
      }
      $unit{$name} = $u;
    }
  }
  close $fh;
}

if (@errors) {
  my %seen;
  for (@errors) { next if $seen{$_}++; print STDERR "$_\n"; }
  exit 1;
}

sub median {
  my @s = sort { $a <=> $b } @{ $_[0] };
  my $n = scalar @s;
  return 0 unless $n;
  return $n % 2 ? $s[ ($n - 1) / 2 ] : ($s[ $n / 2 - 1 ] + $s[ $n / 2 ]) / 2;
}

# Round to 6 decimals to keep JSON stable across platforms, then drop the
# trailing zeros so whole numbers stay whole.
sub num { return 0 + sprintf('%.6f', $_[0]); }

my %out;
for my $name (@order) {
  my @v = @{ $vals{$name} };
  my $n = scalar @v;
  my ($min, $max, $sum) = ($v[0], $v[0], 0);
  for my $x (@v) {
    $min = $x if $x < $min;
    $max = $x if $x > $max;
    $sum += $x;
  }
  my $mean = $sum / $n;
  my $stddev = 0;
  if ($n > 1) {
    my $ss = 0;
    $ss += ($_ - $mean) ** 2 for @v;
    $stddev = sqrt($ss / ($n - 1));
  }
  my %entry = (
    count  => $n,
    min    => num($min),
    max    => num($max),
    mean   => num($mean),
    median => num(median(\@v)),
    stddev => num($stddev),
    values => [ map { num($_) } @v ],
    runs   => $runs{$name},
  );
  $entry{unit} = $unit{$name} if exists $unit{$name};

  # Summary restricted to runs that passed validation.
  #
  # Cost and quality per *verified* unit of work is usually the figure that
  # matters: a run that burned the resource and then failed its checks is a
  # real observation, but averaging it in answers a different question. Both
  # are reported so neither has to be recomputed by hand.
  my $vv = $valid_vals{$name};
  if ($vv && @$vv) {
    my ($vmin, $vmax, $vsum) = ($vv->[0], $vv->[0], 0);
    for my $x (@$vv) {
      $vmin = $x if $x < $vmin;
      $vmax = $x if $x > $vmax;
      $vsum += $x;
    }
    my $vmean = $vsum / scalar(@$vv);
    $entry{valid_only} = {
      count  => scalar(@$vv),
      min    => num($vmin),
      max    => num($vmax),
      mean   => num($vmean),
      median => num(median($vv)),
    };
  } else {
    $entry{valid_only} = { count => 0 };
  }
  $out{$name} = \%entry;
}

print JSON::PP->new->canonical->encode(\%out), "\n";
exit 0;
AGG_EOF
}

# Evaluate one hard constraint against a run's measurements
#
# Grammar is deliberately tiny -- <metric> <op> <number> -- and is parsed, not
# evaluated. Nothing from a result file or manifest reaches a shell or an
# expression evaluator.
#
# Args: $1 = constraint, $2 = file of "name<TAB>value" lines
# Returns: 0 satisfied, 1 violated, 2 metric absent
check_constraint() {
  _c_expr="$1"
  _c_file="$2"
  # shellcheck disable=SC2086
  set -- $_c_expr
  _c_name="$1"
  _c_op="$2"
  _c_want="$3"

  _c_have=$(awk -F'\t' -v n="$_c_name" '$1 == n { print $2; found = 1 }
                                        END { if (!found) exit 1 }' "$_c_file") || return 2

  awk -v a="$_c_have" -v b="$_c_want" -v op="$_c_op" 'BEGIN {
    a += 0; b += 0;
    if (op == "==") ok = (a == b);
    else if (op == "!=") ok = (a != b);
    else if (op == "<")  ok = (a <  b);
    else if (op == "<=") ok = (a <= b);
    else if (op == ">")  ok = (a >  b);
    else if (op == ">=") ok = (a >= b);
    exit ok ? 0 : 1
  }'
}

# Validate a constraint expression at parse time so a typo fails immediately
# rather than after a long benchmark has already run.
validate_constraint() {
  _vc_orig="$1"
  # shellcheck disable=SC2086
  set -- $1
  if [ $# -ne 3 ]; then
    error "--require must be '<metric> <op> <number>' (got: $_vc_orig)"
  fi
  case "$1" in
    ''|*[!A-Za-z0-9_.-]*|[!A-Za-z_]*)
      error "--require metric name is invalid: $1"
      ;;
  esac
  case "$2" in
    '=='|'!='|'<'|'<='|'>'|'>=') ;;
    *) error "--require operator must be one of == != < <= > >= (got: $2)" ;;
  esac
  case "$3" in
    ''|*[!0-9.eE+-]*) error "--require right-hand side must be a number (got: $3)" ;;
  esac
  return 0
}

# Write the provenance helper to a temp file
#
# Captures the context needed to interpret and reproduce a result, and the
# configuration fingerprint that a resume is checked against.
write_provenance_helper() {
  PROVENANCE_PL=$(mktemp)
  cat > "$PROVENANCE_PL" << 'PROV_EOF'
#!/usr/bin/perl
# Emit the provenance object for a benchmark.
#
# Usage: provenance.pl <config-file> <env-allow-file> <results-root>
#   <config-file>    one "key\tvalue" line per configuration input; the
#                    fingerprint is taken over this file's canonical form
#   <env-allow-file> one environment variable name per line to capture
#
# Prints: FINGERPRINT\t<sha256>
#         JSON\t<compact provenance object>
#
# Environment handling follows the rule that a result must never carry a dump
# of the environment it ran in. Only named variables are captured, names that
# look like credentials are refused even when explicitly requested, and the
# count of everything left out is recorded so the omission is visible.
use strict;
use warnings;
use JSON::PP;
use Digest::SHA qw(sha256_hex);

my ($config_path, $env_allow_path, $results_root) = @ARGV;
$results_root = 'bench-results' unless defined $results_root && length $results_root;

# ---- configuration fingerprint ----------------------------------------------
my @config;
if (defined $config_path && open my $fh, '<', $config_path) {
  while (my $line = <$fh>) { chomp $line; push @config, $line if length $line; }
  close $fh;
}
# Sorted so that flag order on the command line cannot change the fingerprint
my $canonical = join("\n", sort @config);
my $fingerprint = sha256_hex($canonical);

# ---- git --------------------------------------------------------------------
sub run_cmd {
  my ($cmd) = @_;
  my $out = `$cmd 2>/dev/null`;
  return undef if $? != 0;
  chomp $out;
  return length $out ? $out : undef;
}

my $git;
if (defined run_cmd('git rev-parse --is-inside-work-tree')) {
  my $commit = run_cmd('git rev-parse HEAD');
  my $branch = run_cmd('git rev-parse --abbrev-ref HEAD');
  # Bench's own results directory is excluded from the dirty check. Without
  # that, "dirty" would report true on every resume simply because the earlier
  # sitting left its output on disk -- which says nothing about whether the
  # recorded commit still describes the code that ran.
  my $status = `git status --porcelain 2>/dev/null`;
  my $dirty = 0;
  if (defined $status) {
    for my $line (split /\n/, $status) {
      next unless $line =~ /\S/;
      my $path = length($line) > 3 ? substr($line, 3) : '';
      $path =~ s/^"//; $path =~ s/"$//;
      next if $path =~ m{(?:^|/)\Q$results_root\E/};
      $dirty = 1;
      last;
    }
  }
  $git = {
    commit => $commit,
    branch => $branch,
    # A dirty tree means the recorded commit does not describe what ran
    dirty  => $dirty ? JSON::PP::true : JSON::PP::false,
  };
}

# ---- machine ----------------------------------------------------------------
my $cpus = run_cmd('getconf _NPROCESSORS_ONLN');
my $mem_mb;
if (open my $mi, '<', '/proc/meminfo') {
  while (my $l = <$mi>) { if ($l =~ /^MemTotal:\s+(\d+)/) { $mem_mb = int($1 / 1024); last; } }
  close $mi;
} else {
  my $bytes = run_cmd('sysctl -n hw.memsize');   # macOS
  $mem_mb = int($bytes / 1048576) if defined $bytes && $bytes =~ /^\d+$/;
}

my $machine = {
  os     => scalar(run_cmd('uname -s')),
  kernel => scalar(run_cmd('uname -r')),
  arch   => scalar(run_cmd('uname -m')),
};
$machine->{cpus} = $cpus + 0 if defined $cpus && $cpus =~ /^\d+$/;
$machine->{memory_mb} = $mem_mb + 0 if defined $mem_mb;

# ---- tool versions ----------------------------------------------------------
my %tools;
my $perl_v = sprintf('%vd', $^V);
$tools{perl} = $perl_v if defined $perl_v;
my $bc_v = run_cmd('bc --version | head -1');
$tools{bc} = $bc_v if defined $bc_v;
my $git_v = run_cmd('git --version');
$tools{git} = $git_v if defined $git_v;

# ---- environment ------------------------------------------------------------
my @allow;
if (defined $env_allow_path && open my $eh, '<', $env_allow_path) {
  while (my $l = <$eh>) { chomp $l; push @allow, $l if length $l; }
  close $eh;
}

# Refused regardless of the allowlist: a result file is shared, and a captured
# credential cannot be un-shared.
my $secretish = qr/(?:KEY|TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIAL|AUTH|SESSION|COOKIE)/i;

my (%captured, @redacted);
my %seen;
for my $name (@allow) {
  next if $seen{$name}++;
  if ($name =~ $secretish) { push @redacted, $name; next; }
  $captured{$name} = $ENV{$name} if exists $ENV{$name};
}
my $omitted = scalar(grep { !exists $captured{$_} } keys %ENV);

my $prov = {
  config_fingerprint => $fingerprint,
  machine            => $machine,
  tools              => \%tools,
  environment        => {
    captured      => \%captured,
    redacted      => [ sort @redacted ],
    omitted_count => $omitted,
  },
};
$prov->{git} = $git if defined $git;

print "FINGERPRINT\t$fingerprint\n";
print "JSON\t", JSON::PP->new->canonical->encode($prov), "\n";
exit 0;
PROV_EOF
}

# Write the resume-state helper to a temp file
#
# Rehydrates the working files bench keeps during a benchmark from a previous
# benchmark.json, so that a resumed run continues into exactly the same
# machinery a fresh run uses and the final aggregation is computed over the
# combined sample.
write_resume_helper() {
  RESUME_PL=$(mktemp)
  cat > "$RESUME_PL" << 'RESUME_EOF'
#!/usr/bin/perl
# Load prior state from an interrupted benchmark.
#
# Usage: resume.pl <benchmark.json> <runs-out> <times-out> <exits-out> <measurements-out>
#
# Prints one key=value line per restored counter, plus the stored
# configuration needed to verify the resume:
#   COMPLETED=<n>  VALID=<n>  REQUESTED=<n>  FINGERPRINT=<hex>
#   STATUS_<name>=<n>
#   CONFIG_<key>=<value>
#
# Runs already recorded are kept exactly as they were. Only runs that never
# produced a record are re-run: a run that completed and was judged invalid is
# a real observation, and re-rolling it until it passes would bias the sample
# toward success, which is precisely what this tool exists to prevent.
use strict;
use warnings;
use JSON::PP;

my ($json_path, $runs_out, $times_out, $exits_out, $meas_out) = @ARGV;

open my $in, '<', $json_path or die "cannot read $json_path: $!\n";
my $txt = do { local $/; <$in> };
close $in;

my $data = eval { JSON::PP->new->decode($txt) };
die "prior benchmark.json is not valid JSON\n" if $@ || ref $data ne 'HASH';

my $runs = $data->{runs};
$runs = [] unless ref $runs eq 'ARRAY';

open my $ro, '>', $runs_out  or die "cannot write $runs_out: $!\n";
open my $to, '>', $times_out or die "cannot write $times_out: $!\n";
open my $eo, '>', $exits_out or die "cannot write $exits_out: $!\n";
open my $mo, '>', $meas_out  or die "cannot write $meas_out: $!\n";

my $enc = JSON::PP->new->canonical;
my %status_counts;
my $valid = 0;

for my $r (@$runs) {
  next unless ref $r eq 'HASH';
  print $ro $enc->encode($r), "\n";
  print $to (defined $r->{duration_ms} ? $r->{duration_ms} : 0), "\n";
  print $eo (defined $r->{exit_code}   ? $r->{exit_code}   : 0), "\n";

  my $st = defined $r->{status} ? $r->{status} : 'ok';
  $status_counts{$st}++;
  $valid++ if $r->{valid};

  my $ev = $r->{evidence};
  if (ref $ev eq 'HASH' && ref $ev->{metrics} eq 'HASH') {
    my $units = ref $ev->{units} eq 'HASH' ? $ev->{units} : {};
    for my $name (sort keys %{ $ev->{metrics} }) {
      my $u = defined $units->{$name} ? $units->{$name} : '';
      print $mo join("\t", $r->{run_number}, $name, $ev->{metrics}{$name}, $u,
                            ($r->{valid} ? 1 : 0)), "\n";
    }
  }
}
close $ro; close $to; close $eo; close $mo;

printf "COMPLETED=%d\n", scalar(@$runs);
printf "VALID=%d\n", $valid;
printf "REQUESTED=%d\n", (defined $data->{runs_requested} ? $data->{runs_requested} : scalar(@$runs));
printf "STATUS_%s=%d\n", $_, $status_counts{$_} for sort keys %status_counts;

my $prov = ref $data->{provenance} eq 'HASH' ? $data->{provenance} : {};
printf "FINGERPRINT=%s\n", (defined $prov->{config_fingerprint} ? $prov->{config_fingerprint} : '');

# Values the resumed invocation must reproduce
printf "CONFIG_command=%s\n", (defined $data->{command} ? $data->{command} : '');
printf "CONFIG_name=%s\n",    (defined $data->{name}    ? $data->{name}    : '');
printf "CONFIG_message=%s\n", (defined $data->{message} ? $data->{message} : '');

# Prior resume history, re-emitted so it can be carried forward
printf "RESUMES=%s\n", $enc->encode(ref $prov->{resumes} eq 'ARRAY' ? $prov->{resumes} : []);
exit 0;
RESUME_EOF
}

# Write the manifest helper to a temp file
#
# Parses and validates an experiment manifest.
#
# Why a restricted YAML subset rather than a YAML library: YAML::PP is not
# core Perl, and taking a CPAN dependency would cost the property that bench
# runs wherever perl does. The manifest schema is deliberately small, so a
# parser for exactly that shape is a few dozen lines and can reject anything
# it does not understand instead of guessing. A .json manifest is accepted
# too, parsed by JSON::PP, for anyone who would rather not rely on the subset.
write_manifest_helper() {
  MANIFEST_PL=$(mktemp)
  cat > "$MANIFEST_PL" << 'MANIFEST_EOF'
#!/usr/bin/perl
# Parse and validate an experiment manifest.
#
# Usage: manifest.pl <manifest-path>
#
# On success prints a tab-separated line protocol and exits 0:
#   FIELD    <key> <value>
#   VARIANT  <name>
#   VARENV   <variant> <key> <value>
#   VARCMD   <variant> <command>
#   METRIC   <name> <attribute> <value>
#   JSON     <normalized manifest>
#
# On failure prints one diagnostic per line to stderr and exits 1.
use strict;
use warnings;
use JSON::PP;

my ($path) = @ARGV;
my @errors;
sub fail { push @errors, $_[0]; }

# -----------------------------------------------------------------------------
# Restricted YAML subset
#
# Supported: comments, blank lines, "key: value", nested maps by indentation,
# "- item" sequences, single/double quoted scalars, integers, floats, true,
# false and null. Anything else -- anchors, aliases, flow collections, multi
# line scalars, tabs for indentation -- is an error rather than a guess.
# -----------------------------------------------------------------------------
sub parse_scalar {
  my ($raw, $line) = @_;
  $raw =~ s/\s+$//;
  return undef if !defined $raw || $raw eq '' || $raw eq '~' || lc($raw) eq 'null';
  if ($raw =~ /^"(.*)"$/) { my $v = $1; $v =~ s/\\"/"/g; $v =~ s/\\\\/\\/g; return $v; }
  if ($raw =~ /^'(.*)'$/) { my $v = $1; $v =~ s/''/'/g; return $v; }
  return JSON::PP::true  if $raw eq 'true';
  return JSON::PP::false if $raw eq 'false';
  if ($raw =~ /^-?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?$/) { return $raw + 0; }
  if ($raw =~ /^[\[{]/) {
    fail("line $line: flow collections are not supported; use an indented block");
    return undef;
  }
  return $raw;
}

# Parse a block starting at $i with indentation greater than $parent_indent.
# Returns (structure, next index).
sub parse_block {
  my ($lines, $i, $parent_indent) = @_;
  my ($map, $seq);
  my $indent;

  while ($$i < scalar @$lines) {
    my ($text, $lineno) = @{ $lines->[$$i] };
    my ($sp) = $text =~ /^(\s*)/;
    my $this_indent = length $sp;
    last if $this_indent <= $parent_indent;

    $indent = $this_indent unless defined $indent;
    if ($this_indent != $indent) {
      fail("line $lineno: inconsistent indentation");
      $$i++;
      next;
    }

    my $body = $text;
    $body =~ s/^\s+//;

    if ($body =~ /^-\s*(.*)$/) {
      my $item = $1;
      $seq = [] unless defined $seq;
      push @$seq, parse_scalar($item, $lineno);
      $$i++;
      next;
    }

    if ($body =~ /^([A-Za-z_][A-Za-z0-9_.-]*)\s*:\s*(.*)$/) {
      my ($key, $rest) = ($1, $2);
      $map = {} unless defined $map;
      $$i++;
      if ($rest =~ /\S/) {
        $map->{$key} = parse_scalar($rest, $lineno);
      } else {
        my $child = parse_block($lines, $i, $this_indent);
        $map->{$key} = defined $child ? $child : {};
      }
      next;
    }

    fail("line $lineno: cannot parse '$body'");
    $$i++;
  }
  return defined $seq ? $seq : $map;
}

sub parse_yaml_subset {
  my ($text) = @_;
  my @lines;
  my $n = 0;
  for my $raw (split /\n/, $text, -1) {
    $n++;
    my $line = $raw;
    # Strip comments that are not inside a quoted scalar
    if ($line =~ /^\s*#/) { next; }
    $line =~ s/\s+#\s.*$// unless $line =~ /["']/;
    next unless $line =~ /\S/;
    if ($line =~ /^\t/ || $line =~ /^ *\t/) {
      fail("line $n: tabs cannot be used for indentation");
      next;
    }
    push @lines, [ $line, $n ];
  }
  my $i = 0;
  my $doc = parse_block(\@lines, \$i, -1);
  return $doc;
}

# -----------------------------------------------------------------------------
# Load
# -----------------------------------------------------------------------------
if (!defined $path || !-f $path) {
  print STDERR "manifest not found: " . (defined $path ? $path : '<none>') . "\n";
  exit 1;
}
open my $fh, '<', $path or do { print STDERR "cannot read $path: $!\n"; exit 1; };
my $text = do { local $/; <$fh> };
close $fh;

my $doc;
if ($path =~ /\.json$/i) {
  $doc = eval { JSON::PP->new->decode($text) };
  if ($@) { my $e = $@; $e =~ s/\s+at\s+\S+\s+line\s+\d+\.?\s*$//s; print STDERR "invalid JSON: $e\n"; exit 1; }
} else {
  $doc = parse_yaml_subset($text);
}

if (!@errors && (!defined $doc || ref $doc ne 'HASH')) {
  fail("manifest must be a mapping at the top level");
}

# -----------------------------------------------------------------------------
# Validate
#
# Unknown fields are refused rather than ignored: a misspelled key that is
# silently dropped produces an experiment that is not the one that was written.
# -----------------------------------------------------------------------------
my %known = map { $_ => 1 } qw(
  schema_version name message command setup evaluate cleanup
  runs warmup timeout expect_exit shell
  setup_scope cleanup_scope
  variants metrics require_artifacts capture_env order seed
);

my $MANIFEST_SCHEMA = '1.0';

if (ref $doc eq 'HASH') {
  for my $k (sort keys %$doc) {
    fail("unknown field '$k'") unless $known{$k};
  }

  my $sv = $doc->{schema_version};
  if (!defined $sv) {
    fail("schema_version is required (expected \"$MANIFEST_SCHEMA\")");
  } elsif ("$sv" ne $MANIFEST_SCHEMA) {
    fail("unsupported schema_version '$sv' (this bench understands \"$MANIFEST_SCHEMA\")");
  }

  fail("command is required") unless defined $doc->{command} && !ref $doc->{command};

  for my $k (qw(name message command setup evaluate cleanup timeout order)) {
    next unless exists $doc->{$k};
    fail("$k must be a string") if ref $doc->{$k};
  }

  for my $k (qw(runs warmup seed)) {
    next unless exists $doc->{$k};
    my $v = $doc->{$k};
    fail("$k must be a whole number") unless defined $v && !ref $v && $v =~ /^\d+$/;
  }
  fail("runs must be at least 1") if defined $doc->{runs} && $doc->{runs} =~ /^\d+$/ && $doc->{runs} < 1;

  if (defined $doc->{expect_exit} && !ref $doc->{expect_exit}) {
    my $e = $doc->{expect_exit};
    fail("expect_exit must be a number between 0 and 255, or \"any\"")
      unless $e eq 'any' || ($e =~ /^\d+$/ && $e <= 255);
  }

  if (defined $doc->{timeout} && !ref $doc->{timeout}) {
    fail("timeout must look like 30, 30s, 5m or 1h (got '$doc->{timeout}')")
      unless $doc->{timeout} =~ /^\d+[smh]?$/;
  }

  for my $k (qw(setup_scope cleanup_scope)) {
    next unless defined $doc->{$k};
    fail("$k must be 'experiment', 'variant' or 'run' (got '$doc->{$k}')")
      if ref $doc->{$k} || $doc->{$k} !~ /^(?:experiment|variant|run)$/;
  }

  if (defined $doc->{order} && !ref $doc->{order}) {
    fail("order must be 'interleaved', 'random' or 'sequential' (got '$doc->{order}')")
      unless $doc->{order} =~ /^(?:interleaved|random|sequential)$/;
  }

  if (exists $doc->{variants}) {
    if (ref $doc->{variants} ne 'HASH' || !keys %{ $doc->{variants} }) {
      fail("variants must be a mapping of at least one named variant");
    } else {
      for my $vn (sort keys %{ $doc->{variants} }) {
        fail("variant name '$vn' must contain only letters, digits, '.', '_' or '-'")
          unless $vn =~ /^[A-Za-z_][A-Za-z0-9_.-]*$/;
        my $v = $doc->{variants}{$vn};
        $v = {} unless defined $v;
        if (ref $v ne 'HASH') { fail("variant '$vn' must be a mapping"); next; }
        for my $vk (sort keys %$v) {
          fail("variant '$vn': unknown field '$vk'") unless $vk =~ /^(?:env|command|message)$/;
        }
        if (exists $v->{env}) {
          if (ref $v->{env} ne 'HASH') { fail("variant '$vn': env must be a mapping"); }
          else {
            for my $ek (sort keys %{ $v->{env} }) {
              fail("variant '$vn': environment name '$ek' is not valid")
                unless $ek =~ /^[A-Za-z_][A-Za-z0-9_]*$/;
              fail("variant '$vn': env value for '$ek' must be a scalar")
                if ref $v->{env}{$ek};
            }
          }
        }
      }
    }
  }

  if (exists $doc->{metrics}) {
    if (ref $doc->{metrics} ne 'HASH') {
      fail("metrics must be a mapping of metric names");
    } else {
      for my $mn (sort keys %{ $doc->{metrics} }) {
        fail("metric name '$mn' must match [A-Za-z_][A-Za-z0-9_.-]*")
          unless $mn =~ /^[A-Za-z_][A-Za-z0-9_.-]*$/;
        my $m = $doc->{metrics}{$mn};
        $m = {} unless defined $m;
        if (ref $m ne 'HASH') { fail("metric '$mn' must be a mapping"); next; }
        for my $mk (sort keys %$m) {
          fail("metric '$mn': unknown field '$mk'") unless $mk =~ /^(?:goal|constraint|unit)$/;
        }
        if (defined $m->{goal} && $m->{goal} !~ /^(?:minimize|maximize)$/) {
          fail("metric '$mn': goal must be 'minimize' or 'maximize' (got '$m->{goal}')");
        }
        if (defined $m->{constraint}) {
          my $c = $m->{constraint};
          fail("metric '$mn': constraint must look like '<= 100' or '== 0' (got '$c')")
            unless !ref $c && $c =~ /^\s*(?:==|!=|<=|>=|<|>)\s*-?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?\s*$/;
        }
      }
    }
  }

  if (exists $doc->{require_artifacts}) {
    if (ref $doc->{require_artifacts} ne 'ARRAY') {
      fail("require_artifacts must be a list");
    } else {
      for my $a (@{ $doc->{require_artifacts} }) {
        fail("require_artifacts entries must be relative paths (got '$a')")
          if !defined $a || ref $a || $a =~ m{^/} || $a =~ m{(?:^|/)\.\.(?:/|$)};
      }
    }
  }

  if (exists $doc->{capture_env}) {
    if (ref $doc->{capture_env} ne 'ARRAY') {
      fail("capture_env must be a list of variable names");
    } else {
      for my $e (@{ $doc->{capture_env} }) {
        fail("capture_env entries must be environment variable names (got '$e')")
          unless defined $e && !ref $e && $e =~ /^[A-Za-z_][A-Za-z0-9_]*$/;
      }
    }
  }
}

if (@errors) {
  print STDERR "$_\n" for @errors;
  exit 1;
}

# -----------------------------------------------------------------------------
# Emit
# -----------------------------------------------------------------------------
sub scalar_out {
  my ($v) = @_;
  return '' unless defined $v;
  return $v ? 'true' : 'false' if JSON::PP::is_bool($v);
  return "$v";
}

for my $k (qw(schema_version name message command setup evaluate cleanup
              setup_scope cleanup_scope
              runs warmup timeout expect_exit order seed)) {
  next unless defined $doc->{$k};
  printf "FIELD\t%s\t%s\n", $k, scalar_out($doc->{$k});
}

if (ref $doc->{variants} eq 'HASH') {
  for my $vn (sort keys %{ $doc->{variants} }) {
    printf "VARIANT\t%s\n", $vn;
    my $v = $doc->{variants}{$vn} || {};
    printf "VARCMD\t%s\t%s\n", $vn, scalar_out($v->{command}) if defined $v->{command};
    if (ref $v->{env} eq 'HASH') {
      for my $ek (sort keys %{ $v->{env} }) {
        printf "VARENV\t%s\t%s\t%s\n", $vn, $ek, scalar_out($v->{env}{$ek});
      }
    }
  }
}

if (ref $doc->{metrics} eq 'HASH') {
  for my $mn (sort keys %{ $doc->{metrics} }) {
    my $m = $doc->{metrics}{$mn} || {};
    for my $attr (qw(goal constraint unit)) {
      printf "METRIC\t%s\t%s\t%s\n", $mn, $attr, scalar_out($m->{$attr})
        if defined $m->{$attr};
    }
  }
}

if (ref $doc->{require_artifacts} eq 'ARRAY') {
  printf "ARTIFACT\t%s\n", scalar_out($_) for @{ $doc->{require_artifacts} };
}
if (ref $doc->{capture_env} eq 'ARRAY') {
  printf "CAPTUREENV\t%s\n", scalar_out($_) for @{ $doc->{capture_env} };
}

print "JSON\t", JSON::PP->new->canonical->encode($doc), "\n";
exit 0;
MANIFEST_EOF
}

# Write the comparison helper to a temp file
#
# Compares two completed executions and reports the size of the difference
# together with its uncertainty.
write_compare_helper() {
  COMPARE_PL=$(mktemp)
  cat > "$COMPARE_PL" << 'COMPARE_EOF'
#!/usr/bin/perl
# Compare two benchmark results.
#
# Usage: compare.pl <baseline.json> <candidate.json> <seed> <constraints-file>
#
# Prints the comparison as JSON on stdout. The caller renders it for humans or
# passes it through verbatim.
#
# Confidence intervals are bootstrap percentile intervals rather than
# t-intervals. Benchmark samples are routinely skewed and multi-modal --
# Georges et al. and Mytkowicz et al. are the standard references for why --
# and the bootstrap makes no normality assumption. The resampling uses an
# explicit linear congruential generator seeded from the command line, so the
# interval is reproducible on any machine and any Perl build rather than
# depending on the platform's rand().
use strict;
use warnings;
use JSON::PP;

my ($base_path, $cand_path, $seed, $constraint_path) = @ARGV;
$seed = 42 unless defined $seed && $seed =~ /^\d+$/;

sub load {
  my ($path) = @_;
  open my $fh, '<', $path or die "cannot read $path: $!\n";
  my $txt = do { local $/; <$fh> };
  close $fh;
  my $d = eval { JSON::PP->new->decode($txt) };
  die "$path is not valid JSON\n" if $@ || ref $d ne 'HASH';
  return $d;
}

my $base = load($base_path);
my $cand = load($cand_path);

# ---- deterministic PRNG ------------------------------------------------------
# Numerical Recipes LCG; adequate for resampling and identical everywhere.
my $rng_state = $seed % 2147483647;
$rng_state = 1 if $rng_state == 0;
sub next_rand {
  $rng_state = ($rng_state * 1103515245 + 12345) % 2147483648;
  return $rng_state / 2147483648;
}

# ---- statistics --------------------------------------------------------------
sub mean { my $s = 0; $s += $_ for @{ $_[0] }; return @{ $_[0] } ? $s / scalar @{ $_[0] } : 0; }

sub percentile {
  my ($vals, $p) = @_;
  my @s = sort { $a <=> $b } @$vals;
  return 0 unless @s;
  my $rank = int($p * scalar(@s) / 100);
  $rank = $#s if $rank > $#s;
  return $s[$rank];
}

sub median_of {
  my @s = sort { $a <=> $b } @{ $_[0] };
  my $n = scalar @s;
  return 0 unless $n;
  return $n % 2 ? $s[($n - 1) / 2] : ($s[$n / 2 - 1] + $s[$n / 2]) / 2;
}

sub stddev {
  my ($v) = @_;
  my $n = scalar @$v;
  return 0 if $n < 2;
  my $m = mean($v);
  my $ss = 0;
  $ss += ($_ - $m) ** 2 for @$v;
  return sqrt($ss / ($n - 1));
}

sub num { return 0 + sprintf('%.6f', $_[0]); }

# Bootstrap percentile interval for the difference in means.
#
# The sample parameters are deliberately not named $a and $b: those are Perl's
# sort variables, and a lexical of the same name silently breaks every sort in
# the same scope -- which reverses the interval bounds rather than failing.
sub bootstrap_diff_ci {
  my ($xs, $ys, $iters) = @_;
  return (undef, undef) unless @$xs && @$ys;
  my @diffs;
  for (1 .. $iters) {
    my ($sx, $sy) = (0, 0);
    $sx += $xs->[int(next_rand() * scalar @$xs)] for 1 .. scalar @$xs;
    $sy += $ys->[int(next_rand() * scalar @$ys)] for 1 .. scalar @$ys;
    push @diffs, ($sy / scalar @$ys) - ($sx / scalar @$xs);
  }
  my @sorted = sort { $a <=> $b } @diffs;
  my $lo = $sorted[ int(0.025 * scalar @sorted) ];
  my $hi = $sorted[ int(0.975 * scalar @sorted) ];
  $hi = $sorted[-1] unless defined $hi;
  return ($lo, $hi);
}

sub summarize {
  my ($v) = @_;
  my @sorted = sort { $a <=> $b } @$v;
  return {
    count  => scalar @$v,
    mean   => num(mean($v)),
    median => num(median_of($v)),
    min    => num(@sorted ? $sorted[0]  : 0),
    max    => num(@sorted ? $sorted[-1] : 0),
    stddev => num(stddev($v)),
    p95    => num(percentile($v, 95)),
    p99    => num(percentile($v, 99)),
  };
}

# ---- gather samples ----------------------------------------------------------
# Timing comes from valid runs only: a run that failed its checks did not do
# the work being timed, so including it compares different things.
sub timing_sample {
  my ($d) = @_;
  my @v;
  for my $r (@{ $d->{runs} || [] }) {
    next unless ref $r eq 'HASH';
    next unless $r->{valid};
    push @v, $r->{duration_ms} + 0 if defined $r->{duration_ms};
  }
  return \@v;
}

sub metric_sample {
  my ($d, $name) = @_;
  my $m = $d->{metrics};
  return [] unless ref $m eq 'HASH' && ref $m->{$name} eq 'HASH';
  my $vals = $m->{$name}{values};
  my $runs = $m->{$name}{runs};
  return [] unless ref $vals eq 'ARRAY';
  # Restrict to observations from valid runs, matching the timing rule
  my %valid = map { $_->{run_number} => 1 }
              grep { ref $_ eq 'HASH' && $_->{valid} } @{ $d->{runs} || [] };
  my @out;
  for my $i (0 .. $#$vals) {
    my $rn = (ref $runs eq 'ARRAY' && defined $runs->[$i]) ? $runs->[$i] : undef;
    next if defined $rn && !$valid{$rn};
    push @out, $vals->[$i] + 0;
  }
  return \@out;
}

sub compare_series {
  my ($xs, $ys, $paired_ok) = @_;
  my $out = {
    baseline  => summarize($xs),
    candidate => summarize($ys),
  };
  return $out unless @$xs && @$ys;

  my $ma = mean($xs);
  my $mb = mean($ys);
  $out->{absolute_difference} = num($mb - $ma);
  $out->{relative_difference_percent} =
    $ma == 0 ? undef : num(100 * ($mb - $ma) / $ma);

  my ($lo, $hi) = bootstrap_diff_ci($xs, $ys, 2000);
  if (defined $lo) {
    $out->{difference_ci_95} = [ num($lo), num($hi) ];
    # "Detectable" only says the interval excludes zero. Whether a difference
    # of this size matters is a question about the system, not the sample.
    $out->{interval_excludes_zero} =
      (($lo > 0 && $hi > 0) || ($lo < 0 && $hi < 0)) ? JSON::PP::true : JSON::PP::false;
  }

  if ($paired_ok && scalar(@$xs) == scalar(@$ys) && @$xs > 1) {
    my @d = map { $ys->[$_] - $xs->[$_] } 0 .. $#$xs;
    my ($plo, $phi) = bootstrap_diff_ci([ map { 0 } @d ], \@d, 2000);
    $out->{paired} = {
      mean_difference => num(mean(\@d)),
      ci_95           => defined $plo ? [ num($plo), num($phi) ] : undef,
    };
  }
  return $out;
}

# ---- validity ----------------------------------------------------------------
sub validity_of {
  my ($d) = @_;
  my $completed = $d->{runs_completed} || 0;
  my $valid     = defined $d->{runs_valid} ? $d->{runs_valid} : $completed;
  return {
    runs_completed => $completed + 0,
    runs_valid     => $valid + 0,
    runs_invalid   => $completed - $valid,
    invalid_rate_percent => $completed ? num(100 * ($completed - $valid) / $completed) : 0,
    validity       => ($d->{validity} || {}),
  };
}

# ---- constraints -------------------------------------------------------------
my @constraints;
if (defined $constraint_path && -f $constraint_path && open my $cf, '<', $constraint_path) {
  while (my $l = <$cf>) { chomp $l; push @constraints, $l if $l =~ /\S/; }
  close $cf;
}

sub metric_names {
  my ($d) = @_;
  return () unless ref $d->{metrics} eq 'HASH';
  return keys %{ $d->{metrics} };
}

my %seen;
my @shared = grep { !$seen{$_}++ }
             grep { my $n = $_; grep { $_ eq $n } metric_names($cand) } metric_names($base);

my %metrics_out;
for my $name (sort @shared) {
  my $a = metric_sample($base, $name);
  my $b = metric_sample($cand, $name);
  next unless @$a || @$b;
  $metrics_out{$name} = compare_series($a, $b, 1);
}

# Evaluate constraints against the candidate's valid-run means
my @constraint_results;
for my $c (@constraints) {
  my ($name, $op, $want) = split /\s+/, $c, 3;
  my $entry = { expression => $c };
  my $sample = $name eq 'duration_ms' ? timing_sample($cand) : metric_sample($cand, $name);
  if (!@$sample) {
    $entry->{status} = 'unknown';
    $entry->{reason} = "the candidate reported no valid observations of '$name'";
  } else {
    my $have = mean($sample);
    my $ok = $op eq '==' ? $have == $want
           : $op eq '!=' ? $have != $want
           : $op eq '<'  ? $have <  $want
           : $op eq '<=' ? $have <= $want
           : $op eq '>'  ? $have >  $want
           : $op eq '>=' ? $have >= $want
           : undef;
    $entry->{observed} = num($have);
    $entry->{status} = defined $ok ? ($ok ? 'passed' : 'failed') : 'unknown';
  }
  push @constraint_results, $entry;
}

my $report = {
  schema_version => '1.0',
  seed           => $seed + 0,
  bootstrap_iterations => 2000,
  baseline  => {
    path    => $base_path,
    name    => $base->{name},
    message => $base->{message},
    command => $base->{command},
    %{ validity_of($base) },
  },
  candidate => {
    path    => $cand_path,
    name    => $cand->{name},
    message => $cand->{message},
    command => $cand->{command},
    %{ validity_of($cand) },
  },
  timing  => compare_series(timing_sample($base), timing_sample($cand), 1),
  metrics => \%metrics_out,
  constraints => \@constraint_results,
  note => 'Confidence intervals are bootstrap percentile intervals over valid '
        . 'runs. An interval that excludes zero means the difference is '
        . 'detectable in this sample; whether it matters is a separate '
        . 'question this report does not answer.',
};

print JSON::PP->new->canonical->pretty->encode($report);
exit 0;
COMPARE_EOF
}

# Generate auto-name from command
# Algorithm: Remove quotes/special chars → lowercase → spaces to dashes → remove consecutive dashes → truncate 50 → trim trailing dashes
# Falls back to "benchmark" if result is empty (e.g., command is all special chars)
generate_name() {
  name=$(echo "$1" | \
    tr -cd 'a-zA-Z0-9 -' | \
    tr '[:upper:]' '[:lower:]' | \
    tr ' ' '-' | \
    sed 's/--*/-/g' | \
    cut -c1-50 | \
    sed 's/-$//')
  if [ -z "$name" ]; then
    echo "benchmark"
  else
    echo "$name"
  fi
}

# Check dependencies
check_dependencies() {
  # Check for perl
  if ! command -v perl >/dev/null 2>&1; then
    error "Required dependency 'perl' not found. Please install perl."
  fi

  # Check for bc
  if ! command -v bc >/dev/null 2>&1; then
    error "Required dependency 'bc' not found. Please install bc."
  fi

  # Check for Time::HiRes module
  if ! perl -MTime::HiRes -e 'exit 0' 2>/dev/null; then
    error "Required Perl module 'Time::HiRes' not found. Please install libtime-hires-perl or equivalent."
  fi

  # Check for JSON::PP (core Perl since 5.14; used to parse and validate the
  # evidence a benchmarked command emits)
  if ! perl -MJSON::PP -e 'exit 0' 2>/dev/null; then
    error "Required Perl module 'JSON::PP' not found. Please install libjson-pp-perl or equivalent."
  fi

  # Check for Digest::SHA (core Perl since 5.10; used to fingerprint the
  # configuration so a resumed run can prove it matches)
  if ! perl -MDigest::SHA -e 'exit 0' 2>/dev/null; then
    error "Required Perl module 'Digest::SHA' not found. Please install libdigest-sha-perl or equivalent."
  fi
}

# Get process stats (CPU%, memory in MB) using ps
# Returns: "cpu_percent memory_mb" or empty if process not found
get_process_stats() {
  pid="$1"
  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    echo ""
    return
  fi
  # ps output: %CPU %MEM RSS (in KB)
  # Convert RSS to MB
  stats=$(ps -p "$pid" -o %cpu=,%mem=,rss= 2>/dev/null | tail -1)
  if [ -n "$stats" ]; then
    cpu=$(echo "$stats" | awk '{print $1}')
    rss_kb=$(echo "$stats" | awk '{print $3}')
    mem_mb=$(echo "scale=2; $rss_kb / 1024" | bc)
    echo "$cpu $mem_mb"
  else
    echo ""
  fi
}

# Get process name from ps
# Returns: process command name or empty if not found
get_process_name() {
  pid="$1"
  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    echo ""
    return
  fi
  ps -p "$pid" -o comm= 2>/dev/null | head -1
}

# Resolve port to PID using lsof or ss
#
# Why lsof first, ss as fallback?
#   - lsof: widely available, consistent interface across Unix systems
#   - ss: modern Linux replacement for netstat, faster but Linux-only
#   - Timeout (3s) prevents hanging on unresponsive systems
#
# Returns: PID of process listening on port, or empty string if not found
resolve_port_to_pid() {
  port="$1"
  # Use timeout if available (3 seconds max)
  timeout_cmd=""
  if command -v timeout >/dev/null 2>&1; then
    timeout_cmd="timeout 3"
  fi

  if command -v lsof >/dev/null 2>&1; then
    $timeout_cmd lsof -ti :"$port" -sTCP:LISTEN 2>/dev/null | head -1
  elif command -v ss >/dev/null 2>&1; then
    # Fallback to ss
    $timeout_cmd ss -tlnp 2>/dev/null | grep ":$port " | sed -n 's/.*pid=\([0-9]*\).*/\1/p' | head -1
  else
    echo ""
  fi
}

# Sample all monitored processes once (optimized for low overhead)
# Writes to: $OUTPUT_DIR/runs/${run_num}.${proc_name}.metrics
#
# Args:
#   $1 = run number
#   $2 = timestamp (either ISO format or relative like "+500ms")
#
# Output format: "timestamp cpu:XX.X mem:XX.XX"
#   - Labeled values (cpu:, mem:) for human/LLM readability
#   - Single ps+awk call per process minimizes overhead (~50-150ms total)
#
# Overhead considerations:
#   - Each sample spawns ps(1) and awk(1)
#   - ~50-150ms overhead per sample depending on system
#   - For sub-100ms precision, use specialized tools (pidstat, perf)
sample_processes() {
  run_num="$1"
  timestamp="$2"
  for entry in $MONITOR_PROCESSES; do
    proc_name="${entry%%:*}"
    rest="${entry#*:}"
    proc_pid="${rest%%:*}"

    if kill -0 "$proc_pid" 2>/dev/null; then
      # Single ps+awk call: get cpu% and convert rss KB to MB in one step
      stats=$(ps -p "$proc_pid" -o %cpu=,rss= 2>/dev/null | awk 'NR==1 {printf "%.1f %.2f", $1, $2/1024}')
      if [ -n "$stats" ]; then
        cpu="${stats%% *}"
        mem="${stats#* }"
        echo "$timestamp cpu:$cpu mem:$mem" >> "$OUTPUT_DIR/runs/${run_num}.${proc_name}.metrics"
      fi
    fi
  done
}

# Start background sampler for all monitored processes
#
# Timestamp strategy (optimized for reduced overhead):
#   - START sample: real ISO timestamp via date(1)
#   - LOOP samples: relative timestamps "+500ms", "+1000ms", etc.
#   - END sample: real ISO timestamp via date(1)
#
# Why relative timestamps in loop?
#   - Avoids spawning date(1) on every iteration
#   - Reduces per-sample overhead from ~150ms to ~50ms
#   - Absolute precision not needed for trend analysis
#
# Guaranteed minimum 2 samples per run (START + END) regardless of command duration.
start_metrics_sampler() {
  run_num="$1"
  interval_sec=$(echo "scale=3; $METRICS_INTERVAL / 1000" | bc)

  # Take immediate sample at START with real timestamp
  sample_processes "$run_num" "$(date +%Y-%m-%dT%H:%M:%S)"

  # Start background loop with relative timestamps (no date calls = fast)
  (
    elapsed_ms=0
    while true; do
      sleep "$interval_sec"
      elapsed_ms=$((elapsed_ms + METRICS_INTERVAL))
      sample_processes "$run_num" "+${elapsed_ms}ms"
    done
  ) &
  SAMPLER_PID=$!
}

# Stop background sampler and take final sample
stop_metrics_sampler() {
  run_num="$1"
  if [ -n "$SAMPLER_PID" ]; then
    kill "$SAMPLER_PID" 2>/dev/null
    wait "$SAMPLER_PID" 2>/dev/null
    SAMPLER_PID=""
  fi
  # Take final sample at END with real timestamp
  sample_processes "$run_num" "$(date +%Y-%m-%dT%H:%M:%S)"
}

# Run a lifecycle hook
#
# Scope is explicit rather than inferred: "experiment" runs once around the
# whole execution, "variant" once around each variant's observations, "run"
# before every single run. A hook that fails stops the experiment, because
# continuing would measure a system that was not prepared.
#
# Args: $1 = command, $2 = configured scope, $3 = scope being entered,
#       $4 = label for diagnostics
run_hook() {
  [ -n "$1" ] || return 0
  [ "$2" = "$3" ] || return 0
  _rh_env=""
  if [ -n "$VARIANT_ENV_FILE" ] && [ -s "$VARIANT_ENV_FILE" ]; then
    _rh_env="$(cat "$VARIANT_ENV_FILE") "
  fi
  if ! sh -c "${_rh_env}$1" >/dev/null 2>&1; then
    error "$4 command failed: $1"
  fi
  return 0
}

# Single-quote a string for safe re-embedding in a shell command
quote_for_sh() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# Record how an experiment with variants was scheduled
#
# Written at the execution root alongside the per-variant results, so the
# ordering and seed that produced them are part of the evidence rather than
# something the reader has to take on trust.
write_experiment_json() {
  _we_root="$1"
  _we_variants=$(printf '%s' "$VARIANT_NAMES" | grep . | perl -ne 'chomp; push @v, $_; END { print join(",", map { "\"$_\"" } @v) }')
  _we_order=$(perl -ne 'chomp; next unless /\S/; my ($v, $r) = split / /; print "{\"variant\":\"$v\",\"run\":$r},";' "$SCHEDULE_FILE" | sed 's/,$//')
  cat > "$_we_root/experiment.json" << EXPJSON
{
  "schema_version": "$SCHEMA_VERSION",
  "tool": "bench",
  "tool_version": "$VERSION",
  "name": "$(json_escape "$NAME")",
  "message": "$(json_escape "$MESSAGE")",
  "manifest": "$(json_escape "$MANIFEST_PATH")",
  "runs_per_variant": $RUNS,
  "warmup": $WARMUP,
  "order": "$ORDER",
  "seed": $SEED,
  "variants": [$_we_variants],
  "execution_order": [$_we_order],
  "provenance": $provenance_full
}
EXPJSON
}

# Build the execution schedule across variants
#
# Why not run every baseline observation and then every candidate one:
# machine state drifts. Temperature, page cache, background activity and time
# of day all move during a long benchmark, and a block design attributes that
# drift to whichever variant ran second. Interleaving spreads it across both.
#
# "interleaved" rotates the variant order each round, so no variant is always
# measured on a cold or warm machine. "random" shuffles each round from the
# recorded seed. "sequential" runs each variant to completion and exists only
# for cases where switching between variants is itself expensive -- it is not
# the default, and results from it carry that bias.
#
# Args: $1 = runs per variant, $2 = order, $3 = seed
build_schedule() {
  _bs_runs="$1"
  _bs_order="$2"
  _bs_seed="$3"
  printf '%s' "$VARIANT_NAMES" | grep . | perl -e '
    my ($runs, $order, $seed) = @ARGV;
    my @variants = map { chomp; $_ } <STDIN>;
    # Same generator as the comparison bootstrap: reproducible everywhere,
    # independent of the platform rand().
    my $state = ($seed % 2147483647) || 1;
    my $rnd = sub {
      $state = ($state * 1103515245 + 12345) % 2147483648;
      return $state / 2147483648;
    };
    if ($order eq "sequential") {
      for my $v (@variants) { print "$v $_\n" for 1 .. $runs; }
      exit 0;
    }
    for my $round (1 .. $runs) {
      my @order = @variants;
      if ($order eq "random") {
        for (my $i = $#order; $i > 0; $i--) {
          my $j = int($rnd->() * ($i + 1));
          @order[$i, $j] = @order[$j, $i];
        }
      } elsif ($order eq "interleaved") {
        my $shift = ($round - 1) % scalar(@order);
        @order = (@order[$shift .. $#order], @order[0 .. $shift - 1]) if $shift;
      }
      print "$_ $round
" for @order;
    }
  ' "$_bs_runs" "$_bs_order" "$_bs_seed"
}

# Point the per-run machinery at one variant's context
#
# The run body reads COMMAND, OUTPUT_DIR and the four accumulator files from
# these variables, so switching variants is a matter of rebinding them. For a
# plain `bench "command"` there is one variant and this is a no-op after the
# first call.
select_variant() {
  _sv_name="$1"
  [ "$CURRENT_VARIANT" = "$_sv_name" ] && return 0
  CURRENT_VARIANT="$_sv_name"

  _sv_dir="$VARIANT_WORK/$_sv_name"
  OUTPUT_DIR=$(cat "$_sv_dir/outdir")
  COMMAND=$(cat "$_sv_dir/command")
  RUNS_FILE="$_sv_dir/runs"
  TIMES_FILE="$_sv_dir/times"
  EXIT_CODES_FILE="$_sv_dir/exits"
  MEASUREMENTS_FILE="$_sv_dir/measurements"
  VARIANT_DONE_FILE="$_sv_dir/done"

  # A variant's environment is applied to the command rather than exported
  # into bench itself, so one variant cannot leak settings into the next.
  VARIANT_ENV_FILE="$_sv_dir/env"
  return 0
}

# Register a variant and its per-variant state
register_variant() {
  _rv_name="$1"
  _rv_command="$2"
  _rv_outdir="$3"
  _rv_dir="$VARIANT_WORK/$_rv_name"
  mkdir -p "$_rv_dir" "$_rv_outdir/runs"
  printf '%s' "$_rv_outdir"  > "$_rv_dir/outdir"
  printf '%s' "$_rv_command" > "$_rv_dir/command"
  : > "$_rv_dir/runs"
  : > "$_rv_dir/times"
  : > "$_rv_dir/exits"
  : > "$_rv_dir/measurements"
  : > "$_rv_dir/done"
  : > "$_rv_dir/env"
  mkdir -p "$_rv_dir/warmup"
  VARIANT_NAMES="$VARIANT_NAMES$_rv_name
"
}

# Count per-status outcomes for one variant from its recorded runs
#
# Derived rather than tallied during the loop: with several variants in flight
# a set of counters per variant would have to be kept in shell variables, and
# the runs file already holds the answer.
derive_tallies() {
  perl -MJSON::PP -e '
    my %n = (ok => 0, command_failed => 0, invalid_result => 0,
             declared_invalid => 0, evaluator_failed => 0,
             constraint_failed => 0, infrastructure_failed => 0);
    my ($completed, $valid) = (0, 0);
    while (my $line = <STDIN>) {
      next unless $line =~ /\S/;
      my $r = eval { JSON::PP->new->decode($line) };
      next unless ref $r eq "HASH";
      $completed++;
      my $st = defined $r->{status} ? $r->{status} : "ok";
      $n{$st}++ if exists $n{$st};
      $valid++ if $r->{valid};
    }
    print "RUNS_COMPLETED=$completed
";
    print "runs_valid=$valid
";
    print "status_$_=$n{$_}
" for sort keys %n;
  ' < "$1"
}

# Subcommand: run an experiment from a manifest
#
# Reads the manifest into the same settings the flag interface uses, so a
# manifest run and a command-line run go through one code path. Flags given
# after the manifest still win, which makes --resume and --quiet usable
# without editing the file.
load_manifest() {
  MANIFEST_PATH="$1"
  [ -n "$MANIFEST_PATH" ] || error "run requires a manifest path"
  shift 2>/dev/null || true

  VARIANT_ERR_FILE=$(mktemp)
  MANIFEST_CONSTRAINTS=$(mktemp)
  MANIFEST_ARTIFACTS=$(mktemp)
  MANIFEST_VARIANTS=$(mktemp)

  check_dependencies
  write_manifest_helper
  if ! manifest_out=$(perl "$MANIFEST_PL" "$MANIFEST_PATH" 2>"$VARIANT_ERR_FILE"); then
    sed 's/^/  /' "$VARIANT_ERR_FILE" >&2
    rm -f "$VARIANT_ERR_FILE"
    error "$MANIFEST_PATH is not a valid experiment manifest"
  fi
  rm -f "$VARIANT_ERR_FILE"

  _lm_field() { printf '%s\n' "$manifest_out" | sed -n "s/^FIELD	$1	//p"; }

  COMMAND=$(_lm_field command)
  _lm_name=$(_lm_field name);        [ -n "$_lm_name" ] && NAME="$_lm_name"
  _lm_msg=$(_lm_field message);      [ -n "$_lm_msg" ] && MESSAGE="$_lm_msg"
  SETUP_CMD=$(_lm_field setup)
  EVALUATE_CMD=$(_lm_field evaluate)
  CLEANUP_CMD=$(_lm_field cleanup)
  _lm_ss=$(_lm_field setup_scope);   [ -n "$_lm_ss" ] && SETUP_SCOPE="$_lm_ss"
  _lm_cs=$(_lm_field cleanup_scope); [ -n "$_lm_cs" ] && CLEANUP_SCOPE="$_lm_cs"
  _lm_runs=$(_lm_field runs);        [ -n "$_lm_runs" ] && RUNS="$_lm_runs"
  _lm_warm=$(_lm_field warmup);      [ -n "$_lm_warm" ] && WARMUP="$_lm_warm"
  _lm_to=$(_lm_field timeout);       [ -n "$_lm_to" ] && TIMEOUT="$_lm_to"
  _lm_ee=$(_lm_field expect_exit);   [ -n "$_lm_ee" ] && EXPECT_EXIT="$_lm_ee"
  _lm_order=$(_lm_field order);      [ -n "$_lm_order" ] && ORDER="$_lm_order"
  _lm_seed=$(_lm_field seed);        [ -n "$_lm_seed" ] && SEED="$_lm_seed"

  # Constraints declared per metric become the same hard constraints the
  # --require flag produces, so validity means one thing however it was asked for.
  printf '%s\n' "$manifest_out" | sed -n 's/^METRIC	\([^	]*\)	constraint	\(.*\)$/\1 \2/p' \
  | while IFS= read -r c; do
      [ -n "$c" ] || continue
      printf '%s\n' "$c"
    done > "$MANIFEST_CONSTRAINTS"
  if [ -s "$MANIFEST_CONSTRAINTS" ]; then
    [ -n "$REQUIRE_FILE" ] || REQUIRE_FILE=$(mktemp)
    while IFS= read -r c; do
      [ -n "$c" ] || continue
      validate_constraint "$c"
      printf '%s\n' "$c" >> "$REQUIRE_FILE"
    done < "$MANIFEST_CONSTRAINTS"
  fi

  printf '%s\n' "$manifest_out" | sed -n 's/^ARTIFACT	//p' | while IFS= read -r a; do
    [ -n "$a" ] && printf '%s\n' "$a"
  done > "$MANIFEST_ARTIFACTS"
  while IFS= read -r a; do
    [ -n "$a" ] || continue
    REQUIRE_ARTIFACTS="$REQUIRE_ARTIFACTS$a
"
  done < "$MANIFEST_ARTIFACTS"

  while IFS= read -r e; do
    [ -n "$e" ] || continue
    CAPTURE_ENV="$CAPTURE_ENV
$e"
  done <<CAPTURE_EOF
$(printf '%s\n' "$manifest_out" | sed -n 's/^CAPTUREENV	//p')
CAPTURE_EOF

  # Variants: one line of "<name><tab><command>", plus an env file each
  VARIANT_ENV_SRC=$(mktemp -d)
  MANIFEST_ENV_DIR="$VARIANT_ENV_SRC"
  _lm_variants=$(printf '%s\n' "$manifest_out" | sed -n 's/^VARIANT	//p')
  if [ -n "$_lm_variants" ]; then
    VARIANT_SPEC=""
    printf '%s\n' "$_lm_variants" | grep . | while IFS= read -r v; do
      [ -n "$v" ] || continue
      vc=$(printf '%s\n' "$manifest_out" | sed -n "s/^VARCMD	$v	//p")
      printf '%s\t%s\n' "$v" "$vc"
      printf '%s\n' "$manifest_out" \
        | sed -n "s/^VARENV	$v	\([^	]*\)	\(.*\)$/\1=\2/p" \
        | while IFS= read -r kv; do
            k="${kv%%=*}"
            val="${kv#*=}"
            printf '%s=%s ' "$k" "$(quote_for_sh "$val")"
          done > "$VARIANT_ENV_SRC/$v"
    done > "$MANIFEST_VARIANTS"
    VARIANT_SPEC=$(cat "$MANIFEST_VARIANTS")
  fi

  # Remaining arguments are ordinary flags and override the manifest
  MANIFEST_EXTRA_ARGS="$*"
  return 0
}

# Subcommand: validate a manifest
#
# Exits 0 and says so when the manifest is usable; otherwise prints every
# problem found, not just the first, so one pass fixes the file.
cmd_validate() {
  manifest="$1"
  if [ -z "$manifest" ]; then
    error "validate requires a manifest path"
  fi
  check_dependencies
  write_manifest_helper
  if manifest_out=$(perl "$MANIFEST_PL" "$manifest" 2>&1 >/dev/null); then
    :
  else
    printf '%s\n' "$manifest_out" | sed 's/^/  /' >&2
    error "$manifest is not a valid experiment manifest"
  fi
  variants=$(perl "$MANIFEST_PL" "$manifest" | sed -n 's/^VARIANT\t//p' | tr '\n' ' ')
  echo "$manifest is valid"
  [ -n "$variants" ] && echo "  variants: $variants"
  exit 0
}

# Subcommand: compare two completed executions
cmd_compare() {
  baseline="$1"
  candidate="$2"
  # Checked before shifting: shift is a special builtin, and shifting past the
  # end aborts a non-interactive shell before the diagnostic can be printed.
  if [ -z "$baseline" ] || [ -z "$candidate" ]; then
    error "compare requires two result directories"
  fi
  shift 2
  for d in "$baseline" "$candidate"; do
    [ -f "$d/benchmark.json" ] || error "no benchmark.json in $d"
  done

  compare_json=0
  compare_seed=42
  compare_constraints=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) compare_json=1; shift ;;
      --seed)
        shift
        case "$1" in
          ''|*[!0-9]*) error "--seed requires a whole number" ;;
        esac
        compare_seed="$1"; shift ;;
      --require)
        shift
        [ -n "$1" ] || error "--require requires an expression"
        validate_constraint "$1"
        [ -n "$compare_constraints" ] || compare_constraints=$(mktemp)
        printf '%s\n' "$1" >> "$compare_constraints"
        shift ;;
      *) error "Unknown option for compare: $1" ;;
    esac
  done

  check_dependencies
  write_compare_helper
  report=$(perl "$COMPARE_PL" "$baseline/benchmark.json" "$candidate/benchmark.json" \
                "$compare_seed" "$compare_constraints") \
    || error "could not compare those results"
  [ -n "$compare_constraints" ] && rm -f "$compare_constraints"

  if [ "$compare_json" -eq 1 ]; then
    printf '%s\n' "$report"
    exit 0
  fi

  render_comparison "$report"
  # A failed constraint is a failed comparison: exit non-zero so a script or
  # CI job does not have to parse the report to find that out.
  if printf '%s' "$report" | grep -q '"status" : "failed"'; then
    exit 1
  fi
  exit 0
}

# Render a comparison report for a human reader
render_comparison() {
  printf '%s' "$1" | perl -MJSON::PP -e '
    my $txt = do { local $/; <STDIN> };
    my $r = JSON::PP->new->decode($txt);
    my $fmt = sub {
      my ($s) = @_;
      return sprintf("%10s %10s %10s", "-", "-", "-") unless $s && $s->{count};
      return sprintf("%10.3f %10.3f %10.3f", $s->{mean}, $s->{median}, $s->{p95});
    };
    printf "%s  ->  %s

",
      (defined $r->{baseline}{message} && length $r->{baseline}{message}
        ? $r->{baseline}{message} : "baseline"),
      (defined $r->{candidate}{message} && length $r->{candidate}{message}
        ? $r->{candidate}{message} : "candidate");

    for my $side (qw(baseline candidate)) {
      printf "  %-10s %d/%d runs valid (%.1f%% invalid)
", $side,
        $r->{$side}{runs_valid}, $r->{$side}{runs_completed},
        $r->{$side}{invalid_rate_percent};
    }
    print "
";

    my @rows = (["duration_ms", $r->{timing}]);
    push @rows, [$_, $r->{metrics}{$_}] for sort keys %{ $r->{metrics} || {} };

    printf "  %-22s %10s %10s %10s   %12s  %s
",
      "", "mean", "median", "p95", "change", "95% CI of difference";
    for my $row (@rows) {
      my ($name, $c) = @$row;
      next unless $c && $c->{baseline};
      printf "  %-22s %s
", "$name (baseline)", $fmt->($c->{baseline});
      my $change = defined $c->{relative_difference_percent}
        ? sprintf("%+.2f%%", $c->{relative_difference_percent}) : "-";
      my $ci = $c->{difference_ci_95}
        ? sprintf("[%+.3f, %+.3f]%s", @{ $c->{difference_ci_95} },
                  ($c->{interval_excludes_zero} ? "" : "  (includes zero)"))
        : "-";
      printf "  %-22s %s   %12s  %s
", "$name (candidate)", $fmt->($c->{candidate}), $change, $ci;
      print "
";
    }

    if (@{ $r->{constraints} || [] }) {
      print "  constraints
";
      for my $c (@{ $r->{constraints} }) {
        my $mark = $c->{status} eq "passed" ? "pass"
                 : $c->{status} eq "failed" ? "FAIL" : "????";
        printf "    %-6s %-24s%s
", $mark, $c->{expression},
          (defined $c->{observed} ? sprintf("observed %.4f", $c->{observed})
                                  : ($c->{reason} || ""));
      }
      print "
";
    }
    print "  ", $r->{note}, "
";
  '
}

# Subcommand: summarize one execution for a human reader
cmd_report() {
  dir="$1"
  [ -n "$dir" ] || error "report requires a result directory"
  [ -f "$dir/benchmark.json" ] || error "no benchmark.json in $dir"
  check_dependencies
  perl -MJSON::PP -e '
    open my $fh, "<", $ARGV[0] or die "cannot read $ARGV[0]
";
    my $d = JSON::PP->new->decode(do { local $/; <$fh> });
    printf "%s
", (defined $d->{name} ? $d->{name} : "benchmark");
    printf "  command      %s
", $d->{command};
    printf "  message      %s
", $d->{message} if length($d->{message} // "");
    printf "  runs         %d completed, %d valid, %d invalid
",
      $d->{runs_completed}, $d->{runs_valid} // $d->{runs_completed},
      ($d->{runs_completed} - ($d->{runs_valid} // $d->{runs_completed}));
    my $t = $d->{timing};
    printf "  timing (ms)  mean %.3f  median %.3f  p95 %.3f  stddev %.3f
",
      $t->{mean}, $t->{median}, $t->{p95}, $t->{stddev};
    if (ref $d->{validity} eq "HASH") {
      my @bad = grep { $_ ne "ok" && $d->{validity}{$_} } sort keys %{ $d->{validity} };
      printf "  failures     %s
", join(", ", map { "$_=$d->{validity}{$_}" } @bad) if @bad;
    }
    if (ref $d->{metrics} eq "HASH" && keys %{ $d->{metrics} }) {
      print "  metrics
";
      for my $m (sort keys %{ $d->{metrics} }) {
        my $e = $d->{metrics}{$m};
        printf "    %-24s mean %-12.4f n=%-4d", $m, $e->{mean}, $e->{count};
        printf "  valid-only mean %.4f (n=%d)",
          $e->{valid_only}{mean}, $e->{valid_only}{count}
          if ref $e->{valid_only} eq "HASH" && $e->{valid_only}{count};
        print "
";
      }
    }
    my $p = $d->{provenance};
    if (ref $p eq "HASH") {
      printf "  fingerprint  %s
", substr($p->{config_fingerprint}, 0, 16);
      printf "  git          %s%s
", substr($p->{git}{commit}, 0, 12),
        ($p->{git}{dirty} ? " (dirty)" : "") if ref $p->{git} eq "HASH";
      printf "  resumed      %d time(s)
", scalar @{ $p->{resumes} }
        if ref $p->{resumes} eq "ARRAY" && @{ $p->{resumes} };
    }
  ' "$dir/benchmark.json"
  exit 0
}

# Main entry point
main() {
  # Default values
  RUNS=10
  NAME=""
  MESSAGE=""
  QUIET=0
  MONITOR_PROCESSES=""  # Space-separated list of "name:pid:port" entries
  METRICS_INTERVAL=500  # Sampling interval in milliseconds
  COMMAND=""
  EVALUATE_CMD=""
  EXPECT_EXIT=0         # Exit code the command must return ("any" to accept all)
  REQUIRE_FILE=""       # Temp file holding one --require expression per line
  REQUIRE_ARTIFACTS=""  # Newline-separated required artifact paths
  # Environment variables captured into provenance. Deliberately short: a
  # result file is shared, so capture is opt-in rather than opt-out.
  CAPTURE_ENV="LANG
LC_ALL
LC_NUMERIC
TZ
TERM"
  RESUME_DIR=""
  FORCE_RESUME=0
  VARIANT_SPEC=""      # "<name>\t<command>" per line, from a manifest
  VARIANT_ENV_SRC=""   # directory of per-variant env files
  ORDER="interleaved"
  SEED=42
  SETUP_CMD=""
  CLEANUP_CMD=""
  SETUP_SCOPE="experiment"
  CLEANUP_SCOPE="experiment"
  WARMUP=0
  TIMEOUT=""

  # Subcommand dispatch.
  #
  # Only the first argument is examined, and only when it is not an option, so
  # `bench compare-throughput.sh` still benchmarks a command with that name.
  case "$1" in
    validate) shift; cmd_validate "$@" ;;
    compare)  shift; cmd_compare "$@" ;;
    report)   shift; cmd_report "$@" ;;
    run)
      shift
      load_manifest "$@"
      # Re-enter argument parsing with only the flags that followed the
      # manifest, so --quiet, --resume and friends still apply to a manifest run
      # shellcheck disable=SC2086
      set -- $MANIFEST_EXTRA_ARGS
      ;;
  esac

  # Parse arguments
  while [ $# -gt 0 ]; do
    case "$1" in
      --version)
        show_version
        ;;
      --help)
        show_help
        ;;
      --runs)
        shift
        if [ -z "$1" ]; then
          error "--runs requires an argument"
        fi
        # Validate numeric
        case "$1" in
          ''|*[!0-9]*)
            error "--runs requires a numeric argument"
            ;;
        esac
        # Validate positive
        if [ "$1" -le 0 ]; then
          error "--runs must be a positive number (at least 1)"
        fi
        # Pre-flight disk space check for large runs.
        # Estimate ~10 KB per run (a log, a stdout/stderr pair and a JSON line);
        # the arithmetic below is runs * 10240 / 1000 KB, i.e. ~10 KB each.
        if [ "$1" -gt 10000 ]; then
          # Get available disk space in KB
          available_kb=$(df -k . 2>/dev/null | awk 'NR==2 {print $4}')
          if [ -n "$available_kb" ]; then
            needed_kb=$((${1} * 10240 / 1000))
            if [ "$available_kb" -lt "$needed_kb" ]; then
              error "Insufficient disk space for $1 runs (need ~$((needed_kb / 1024))MB, have ~$((available_kb / 1024))MB)"
            fi
          fi
        fi
        RUNS="$1"
        shift
        ;;
      --name)
        shift
        if [ -z "$1" ]; then
          error "--name requires an argument"
        fi
        # Validate length (max 255 chars)
        if [ "${#1}" -gt 255 ]; then
          error "--name must be 255 characters or less"
        fi
        # NAME becomes a directory under ./bench-results/, so it must stay a
        # single path component. Without this, --name ../../x escapes the
        # results tree and writes wherever the caller can reach.
        case "$1" in
          */*)
            error "--name cannot contain '/'"
            ;;
          .|..)
            error "--name cannot be '.' or '..'"
            ;;
        esac
        NAME="$1"
        shift
        ;;
      --message)
        shift
        if [ -z "$1" ]; then
          error "--message requires an argument"
        fi
        # Validate length (max 1000 chars)
        if [ "${#1}" -gt 1000 ]; then
          error "--message must be 1000 characters or less"
        fi
        MESSAGE="$1"
        shift
        ;;
      --quiet)
        QUIET=1
        shift
        ;;
      --pid)
        shift
        if [ -z "$1" ]; then
          error "--pid requires an argument"
        fi
        # Parse name:pid or just pid format
        case "$1" in
          *:*)
            # name:pid format
            proc_name="${1%%:*}"
            proc_pid="${1#*:}"
            ;;
          *)
            # Just pid, name will be auto-detected later
            proc_name=""
            proc_pid="$1"
            ;;
        esac
        # Validate PID is numeric
        case "$proc_pid" in
          ''|*[!0-9]*)
            error "--pid requires a numeric PID (got: $proc_pid)"
            ;;
        esac
        validate_proc_name "$proc_name" "--pid"
        # Add to monitor list (name:pid:port format, port empty for --pid)
        MONITOR_PROCESSES="$MONITOR_PROCESSES $proc_name:$proc_pid:"
        shift
        ;;
      --port)
        shift
        if [ -z "$1" ]; then
          error "--port requires an argument"
        fi
        # Parse name:port or just port format
        case "$1" in
          *:*)
            # name:port format
            proc_name="${1%%:*}"
            proc_port="${1#*:}"
            ;;
          *)
            # Just port, name will be auto-detected later
            proc_name=""
            proc_port="$1"
            ;;
        esac
        # Validate port is numeric
        case "$proc_port" in
          ''|*[!0-9]*)
            error "--port requires a numeric port (got: $proc_port)"
            ;;
        esac
        validate_proc_name "$proc_name" "--port"
        # Resolve port to PID
        resolved_pid=$(resolve_port_to_pid "$proc_port")
        if [ -z "$resolved_pid" ]; then
          error "No process found listening on port $proc_port"
        fi
        # Add to monitor list (name:pid:port format)
        MONITOR_PROCESSES="$MONITOR_PROCESSES $proc_name:$resolved_pid:$proc_port"
        shift
        ;;
      --evaluate)
        shift
        if [ -z "$1" ]; then
          error "--evaluate requires a command"
        fi
        EVALUATE_CMD="$1"
        shift
        ;;
      --expect-exit)
        shift
        if [ -z "$1" ]; then
          error "--expect-exit requires an argument"
        fi
        if [ "$1" != "any" ]; then
          case "$1" in
            ''|*[!0-9]*)
              error "--expect-exit requires a number or \"any\" (got: $1)"
              ;;
          esac
          if [ "$1" -gt 255 ]; then
            error "--expect-exit must be between 0 and 255 (got: $1)"
          fi
        fi
        EXPECT_EXIT="$1"
        shift
        ;;
      --require)
        shift
        if [ -z "$1" ]; then
          error "--require requires an expression"
        fi
        validate_constraint "$1"
        if [ -z "$REQUIRE_FILE" ]; then
          REQUIRE_FILE=$(mktemp)
        fi
        printf '%s\n' "$1" >> "$REQUIRE_FILE"
        shift
        ;;
      --require-artifact)
        shift
        if [ -z "$1" ]; then
          error "--require-artifact requires a path"
        fi
        case "$1" in
          /*) error "--require-artifact must be relative to the run directory (got: $1)" ;;
          *..*) error "--require-artifact must not escape the run directory (got: $1)" ;;
        esac
        REQUIRE_ARTIFACTS="$REQUIRE_ARTIFACTS$1
"
        shift
        ;;
      --capture-env)
        shift
        if [ -z "$1" ]; then
          error "--capture-env requires a variable name"
        fi
        case "$1" in
          ''|*[!A-Za-z0-9_]*)
            error "--capture-env expects an environment variable name (got: $1)"
            ;;
        esac
        CAPTURE_ENV="$CAPTURE_ENV
$1"
        shift
        ;;
      --resume)
        shift
        if [ -z "$1" ]; then
          error "--resume requires a results directory"
        fi
        if [ ! -f "$1/benchmark.json" ]; then
          error "--resume: no benchmark.json in $1"
        fi
        RESUME_DIR="$1"
        shift
        ;;
      --force-resume)
        FORCE_RESUME=1
        shift
        ;;
      --metrics-interval)
        shift
        if [ -z "$1" ]; then
          error "--metrics-interval requires an argument"
        fi
        case "$1" in
          ''|*[!0-9]*)
            error "--metrics-interval requires a numeric argument"
            ;;
        esac
        if [ "$1" -lt 100 ]; then
          error "--metrics-interval minimum is 100ms"
        fi
        METRICS_INTERVAL="$1"
        shift
        ;;
      --)
        shift
        COMMAND="$*"
        break
        ;;
      -*)
        error "Unknown option: $1"
        ;;
      *)
        COMMAND="$*"
        break
        ;;
    esac
  done

  # Validate command provided
  if [ -z "$COMMAND" ]; then
    error "Command required. Use --help for usage information."
  fi

  # Check dependencies
  check_dependencies

  # Trim leading space from MONITOR_PROCESSES
  MONITOR_PROCESSES=$(echo "$MONITOR_PROCESSES" | sed 's/^ *//')

  # Process and validate monitored processes
  if [ -n "$MONITOR_PROCESSES" ]; then
    validated_processes=""
    seen_names=""
    name_counter=1

    for entry in $MONITOR_PROCESSES; do
      proc_name="${entry%%:*}"
      rest="${entry#*:}"
      proc_pid="${rest%%:*}"
      proc_port="${rest#*:}"

      # Validate PID exists
      if ! kill -0 "$proc_pid" 2>/dev/null; then
        error "Process $proc_pid does not exist"
      fi

      # Auto-detect name if not provided
      if [ -z "$proc_name" ]; then
        proc_name=$(sanitize_proc_name "$(get_process_name "$proc_pid")")
        if [ -z "$proc_name" ]; then
          proc_name="process-$proc_pid"
        fi
        # Handle duplicate auto-detected names by appending suffix.
        # The counter restarts per process so suffixes stay predictable
        # (app, app-2, app-3) instead of depending on earlier entries.
        base_name="$proc_name"
        name_counter=1
        while name_is_seen "$proc_name" "$seen_names"; do
          name_counter=$((name_counter + 1))
          proc_name="${base_name}-${name_counter}"
        done
      else
        # Check for duplicate user-provided names
        if name_is_seen "$proc_name" "$seen_names"; then
          error "Duplicate process name: $proc_name"
        fi
      fi

      seen_names="$seen_names $proc_name"
      validated_processes="$validated_processes $proc_name:$proc_pid:$proc_port"
    done

    MONITOR_PROCESSES=$(echo "$validated_processes" | sed 's/^ *//')
  fi

  # Auto-generate name if not provided
  if [ -z "$NAME" ]; then
    NAME=$(generate_name "$COMMAND")
  fi

  # Create output directory: ./bench-results/<name>/YYYYMMDD-HHMMSS-PID/
  #
  # Directory structure:
  #   bench-results/
  #     <name>/                    # Groups related benchmarks (e.g., "api", "login")
  #       YYYYMMDD-HHMMSS-PID/     # Unique per run (timestamp + PID prevents collisions)
  #         benchmark.json         # Aggregate results and per-run data
  #         runs/
  #           1.log                # Combined stdout+stderr for run 1
  #           1.stdout             # Raw stdout
  #           1.stderr             # Raw stderr
  #           1.app.metrics        # Process metrics samples (if --pid/--port used)
  #
  # Why timestamp-PID suffix?
  #   - Allows concurrent benchmarks with same --name without collision
  #   - PID ensures uniqueness even if started in same second
  #   - Chronological sorting by directory name
  if [ -n "$RESUME_DIR" ]; then
    # Continue writing into the original result directory so the completed
    # runs and the new ones form one result rather than two partial ones
    OUTPUT_DIR="$RESUME_DIR"
    mkdir -p "$OUTPUT_DIR/runs"
    # A run interrupted mid-flight left an INCOMPLETE marker and no record;
    # discard it so the run number is free to be used again.
    for stale in "$OUTPUT_DIR/runs/"*/INCOMPLETE; do
      [ -f "$stale" ] && rm -rf "$(dirname "$stale")"
    done
  else
    timestamp=$(date '+%Y%m%d-%H%M%S')
    OUTPUT_DIR="./bench-results/${NAME}/${timestamp}-$$"
    mkdir -p "$OUTPUT_DIR/runs"
  fi

  # Setup signal handlers
  trap 'handle_interrupt' INT TERM

  # Disable exit on error for benchmark loop (we track failures ourselves)
  set +e

  # Global so that cleanup() can reclaim them on any exit path
  TIMES_FILE=$(mktemp)
  EXIT_CODES_FILE=$(mktemp)
  RUNS_FILE=$(mktemp)
  MEASUREMENTS_FILE=$(mktemp)
  BASE_TEMP_FILES="$TIMES_FILE
$EXIT_CODES_FILE
$RUNS_FILE
$MEASUREMENTS_FILE"
  write_ingest_helper
  write_aggregate_helper
  write_provenance_helper
  write_resume_helper

  # Per-run validity tallies (schema 2.1)
  runs_valid=0
  status_ok=0
  status_command_failed=0
  status_invalid_result=0
  status_declared_invalid=0
  status_evaluator_failed=0
  status_constraint_failed=0
  status_infrastructure_failed=0

  # ---------------------------------------------------------------------------
  # Provenance and resumption
  # ---------------------------------------------------------------------------

  # The fingerprint covers what must hold for two runs to belong to the same
  # experiment. Cosmetic fields (--name, --message) and ephemeral ones (the
  # PIDs behind --pid/--port) are excluded on purpose: they change between
  # sittings without changing what is being measured.
  config_file=$(mktemp)
  {
    printf 'command\t%s\n' "$COMMAND"
    printf 'runs\t%s\n' "$RUNS"
    printf 'expect_exit\t%s\n' "$EXPECT_EXIT"
    printf 'evaluate\t%s\n' "$EVALUATE_CMD"
    printf 'metrics_interval\t%s\n' "$METRICS_INTERVAL"
    if [ -n "$REQUIRE_FILE" ]; then
      sort "$REQUIRE_FILE" | while IFS= read -r c; do printf 'require\t%s\n' "$c"; done
    fi
    printf '%s' "$REQUIRE_ARTIFACTS" | sort | while IFS= read -r a; do
      [ -n "$a" ] && printf 'require_artifact\t%s\n' "$a"
    done
  } > "$config_file"

  env_allow_file=$(mktemp)
  printf '%s\n' "$CAPTURE_ENV" > "$env_allow_file"

  provenance_out=$(perl "$PROVENANCE_PL" "$config_file" "$env_allow_file" "bench-results")
  rm -f "$config_file" "$env_allow_file"
  config_fingerprint=$(printf '%s\n' "$provenance_out" | sed -n 's/^FINGERPRINT\t//p')
  provenance_json=$(printf '%s\n' "$provenance_out" | sed -n 's/^JSON\t//p')

  resumes_json="[]"
  run_start=1
  if [ -n "$RESUME_DIR" ]; then
    resume_state=$(perl "$RESUME_PL" "$RESUME_DIR/benchmark.json" \
                        "$RUNS_FILE" "$TIMES_FILE" "$EXIT_CODES_FILE" "$MEASUREMENTS_FILE") \
      || error "could not read prior results in $RESUME_DIR"

    prior_fingerprint=$(printf '%s\n' "$resume_state" | sed -n 's/^FINGERPRINT=//p')
    prior_completed=$(printf '%s\n' "$resume_state" | sed -n 's/^COMPLETED=//p')
    prior_valid=$(printf '%s\n' "$resume_state" | sed -n 's/^VALID=//p')
    prior_requested=$(printf '%s\n' "$resume_state" | sed -n 's/^REQUESTED=//p')
    resumes_json=$(printf '%s\n' "$resume_state" | sed -n 's/^RESUMES=//p')
    [ -n "$resumes_json" ] || resumes_json="[]"

    # Refuse to extend a sample that was produced under different conditions.
    # An override is allowed but is written into the result, so a reader can
    # see that the sample is not homogeneous.
    mismatch=""
    if [ "$prior_fingerprint" != "$config_fingerprint" ]; then
      mismatch="configuration fingerprint differs from the original run"
    fi
    if [ -n "$mismatch" ] && [ "$FORCE_RESUME" -eq 0 ]; then
      error "$mismatch. Re-run with the original options, or pass --force-resume to record an override."
    fi

    RUNS="$prior_requested"
    RUNS_COMPLETED="$prior_completed"
    runs_valid="$prior_valid"
    run_start=$((prior_completed + 1))
    for st in ok command_failed invalid_result declared_invalid \
              evaluator_failed constraint_failed infrastructure_failed; do
      n=$(printf '%s\n' "$resume_state" | sed -n "s/^STATUS_${st}=//p")
      [ -n "$n" ] && eval "status_${st}=\$n"
    done

    override_json=$([ -n "$mismatch" ] && echo "true" || echo "false")
    mismatch_json=$(json_escape "$mismatch")
    resume_entry="{\"at\":\"$(get_iso_timestamp)\",\"resumed_from_run\":$prior_completed,\"override\":$override_json,\"mismatch\":\"$mismatch_json\"}"
    # Append to the stored history: strip the closing bracket, add a separator
    # when the array already has entries, then re-close.
    resumes_base="${resumes_json%]}"
    if [ "$resumes_base" = "[" ]; then
      resumes_json="[$resume_entry]"
    else
      resumes_json="$resumes_base,$resume_entry]"
    fi
  fi

  # The loop starts past whatever was restored (run 1 for a fresh benchmark)
  run_num="$run_start"

  # Capture initial metrics for all monitored processes (for leak detection)
  initial_metrics=""
  if [ -n "$MONITOR_PROCESSES" ]; then
    for entry in $MONITOR_PROCESSES; do
      proc_name="${entry%%:*}"
      rest="${entry#*:}"
      proc_pid="${rest%%:*}"

      initial_stats=$(get_process_stats "$proc_pid")
      if [ -n "$initial_stats" ]; then
        initial_mem=$(echo "$initial_stats" | awk '{print $2}')
      else
        initial_mem=0
      fi
      initial_metrics="$initial_metrics $proc_name:$initial_mem"
    done
    initial_metrics=$(echo "$initial_metrics" | sed 's/^ *//')
  fi

  # ---------------------------------------------------------------------------
  # Variants and execution schedule
  # ---------------------------------------------------------------------------
  VARIANT_WORK=$(mktemp -d)
  SCHEDULE_FILE=$(mktemp)
  # Held separately because select_variant rebinds OUTPUT_DIR to each variant's
  # directory as the schedule runs
  EXECUTION_DIR="$OUTPUT_DIR"

  if [ -z "$VARIANT_SPEC" ]; then
    # Plain benchmark: one unnamed variant writing straight to OUTPUT_DIR
    MULTI_VARIANT=0
    register_variant "default" "$COMMAND" "$OUTPUT_DIR"
    # A resume restored the prior runs into the top-level accumulators before
    # variants existed; hand them to the single variant that owns them now.
    if [ -n "$RESUME_DIR" ]; then
      cp "$RUNS_FILE"         "$VARIANT_WORK/default/runs"
      cp "$TIMES_FILE"        "$VARIANT_WORK/default/times"
      cp "$EXIT_CODES_FILE"   "$VARIANT_WORK/default/exits"
      cp "$MEASUREMENTS_FILE" "$VARIANT_WORK/default/measurements"
    fi
    r="$run_start"
    while [ "$r" -le "$RUNS" ]; do
      echo "default $r" >> "$SCHEDULE_FILE"
      r=$((r + 1))
    done
  else
    MULTI_VARIANT=1
    # Each variant gets a complete, self-contained result directory, so every
    # downstream tool -- compare, resume, jq -- works on it unchanged.
    printf '%s\n' "$VARIANT_SPEC" | while IFS='	' read -r vname vcmd; do
      [ -n "$vname" ] || continue
      printf '%s\t%s\n' "$vname" "$vcmd"
    done > "$VARIANT_WORK/spec"

    while IFS='	' read -r vname vcmd; do
      [ -n "$vname" ] || continue
      [ -n "$vcmd" ] || vcmd="$COMMAND"
      register_variant "$vname" "$vcmd" "$OUTPUT_DIR/variants/$vname"
      if [ -f "$VARIANT_ENV_SRC/$vname" ]; then
        cp "$VARIANT_ENV_SRC/$vname" "$VARIANT_WORK/$vname/env"
      fi
    done < "$VARIANT_WORK/spec"

    build_schedule "$RUNS" "$ORDER" "$SEED" > "$SCHEDULE_FILE"
  fi

  run_hook "$SETUP_CMD" "$SETUP_SCOPE" experiment "setup"

  # Per-variant setup and warm-up happen before any measured run, so warm-up
  # work never lands in the recorded sample.
  if [ "$WARMUP" -gt 0 ] || [ -n "$SETUP_CMD" ]; then
    printf '%s' "$VARIANT_NAMES" | grep . > "$VARIANT_WORK/prepare"
    while IFS= read -r prep_variant; do
      [ -n "$prep_variant" ] || continue
      CURRENT_VARIANT=""
      select_variant "$prep_variant"
      run_hook "$SETUP_CMD" "$SETUP_SCOPE" variant "setup"
      w=1
      while [ "$w" -le "$WARMUP" ]; do
        _wu_cmd="$COMMAND"
        if [ -n "$VARIANT_ENV_FILE" ] && [ -s "$VARIANT_ENV_FILE" ]; then
          _wu_cmd="$(cat "$VARIANT_ENV_FILE") $COMMAND"
        fi
        BENCH_RUN_DIR="$VARIANT_WORK/$prep_variant/warmup" \
        BENCH_RESULT_JSON="$VARIANT_WORK/$prep_variant/warmup/result.json" \
        BENCH_METRICS="$VARIANT_WORK/$prep_variant/warmup/metrics.jsonl" \
        BENCH_ARTIFACTS="$VARIANT_WORK/$prep_variant/warmup" \
        BENCH_RUN_NUMBER="0" \
        BENCH_RUNS="$RUNS" \
        BENCH_WARMUP="1" \
          sh -c "$_wu_cmd" >/dev/null 2>&1 || true
        w=$((w + 1))
      done
    done < "$VARIANT_WORK/prepare"
    CURRENT_VARIANT=""
  fi

  if [ "$QUIET" -eq 0 ]; then
    if [ "$MULTI_VARIANT" -eq 1 ]; then
      echo "Running $(printf '%s' "$VARIANT_NAMES" | grep -c .) variants x $RUNS runs ($ORDER order, seed $SEED)..." >&2
    else
      echo "Running '$COMMAND' $RUNS times..." >&2
    fi
  fi

  # The loop is driven by a schedule of "<variant> <run number>" entries. A
  # plain `bench "command"` has one variant and a 1..N schedule, so the body
  # below is unchanged for it; an experiment with variants interleaves them in
  # this file instead of running each variant to completion in turn, which
  # would confound the comparison with drift in machine state over time.
  while IFS=' ' read -r sched_variant run_num; do
    [ -n "$sched_variant" ] || continue
    [ "$INTERRUPTED" -eq 0 ] || break

    # Switch to this variant's context: its command, output directory and
    # accumulator files. For the single-variant case these never change.
    select_variant "$sched_variant"
    run_hook "$SETUP_CMD" "$SETUP_SCOPE" run "setup"

    if [ "$QUIET" -eq 0 ]; then
      if [ "$MULTI_VARIANT" -eq 1 ]; then
        printf "\r  %-20s run %d/%d" "$sched_variant" "$run_num" "$RUNS" >&2
      else
        printf "\r  Run %d/%d" "$run_num" "$RUNS" >&2
      fi
    fi

    # Capture timestamps and timing
    start_iso=$(get_iso_timestamp)
    start_time=$(get_time)

    # Start metrics sampler before command
    if [ -n "$MONITOR_PROCESSES" ]; then
      start_metrics_sampler "$run_num"
    fi

    # Run command in background to allow signal handling
    # Capture stdout and stderr separately
    stdout_file="$OUTPUT_DIR/runs/${run_num}.stdout"
    stderr_file="$OUTPUT_DIR/runs/${run_num}.stderr"

    # Per-run evidence directory (schema 2.1). The command writes its
    # measurements and artifacts here; bench writes the normalised result
    # alongside them, so the directory is readable without bench.
    run_dir="$OUTPUT_DIR/runs/${run_num}"
    run_status="ok"
    run_error=""
    if ! mkdir -p "$run_dir/artifacts" 2>/dev/null; then
      run_status="infrastructure_failed"
      run_error="could not create run directory"
    fi
    # An in-flight run is marked incomplete until its record is written, so a
    # run interrupted partway through is visibly unfinished on disk rather
    # than looking like a run that simply produced no evidence.
    : > "$run_dir/INCOMPLETE"

    # A variant's environment is applied here rather than exported into bench,
    # so settings cannot leak from one variant into the next.
    run_cmd="$COMMAND"
    if [ -n "$VARIANT_ENV_FILE" ] && [ -s "$VARIANT_ENV_FILE" ]; then
      run_cmd="$(cat "$VARIANT_ENV_FILE") $COMMAND"
    fi
    # A timeout bounds a run that would otherwise hang the whole experiment.
    if [ -n "$TIMEOUT" ] && command -v timeout >/dev/null 2>&1; then
      run_cmd="timeout $TIMEOUT sh -c $(quote_for_sh "$run_cmd")"
    fi

    BENCH_RUN_DIR="$run_dir" \
    BENCH_RESULT_JSON="$run_dir/result.json" \
    BENCH_METRICS="$run_dir/metrics.jsonl" \
    BENCH_ARTIFACTS="$run_dir/artifacts" \
    BENCH_RUN_NUMBER="$run_num" \
    BENCH_RUNS="$RUNS" \
    BENCH_VARIANT="$CURRENT_VARIANT" \
      sh -c "$run_cmd" > "$stdout_file" 2> "$stderr_file" &
    cmd_pid=$!
    wait $cmd_pid 2>/dev/null
    cmd_exit=$?

    # Stop metrics sampler after command
    if [ -n "$MONITOR_PROCESSES" ]; then
      stop_metrics_sampler "$run_num"
    fi

    end_time=$(get_time)
    end_iso=$(get_iso_timestamp)

    # Check for interrupt after each run
    if [ "$INTERRUPTED" -eq 1 ]; then
      # Kill any remaining child process
      kill $cmd_pid 2>/dev/null || true
      break
    fi

    # Calculate durations
    duration_ms=$(bc_normalize "scale=6; ($end_time - $start_time) * 1000")
    duration_sec=$(bc_normalize "scale=6; $end_time - $start_time")

    # Get output sizes
    stdout_bytes=$(wc -c < "$stdout_file")
    stderr_bytes=$(wc -c < "$stderr_file")

    # Combine stdout/stderr into single log for backwards compatibility
    cat "$stdout_file" "$stderr_file" > "$OUTPUT_DIR/runs/${run_num}.log"

    # Calculate per-run metrics from .metrics files
    processes_json=""
    if [ -n "$MONITOR_PROCESSES" ]; then
      first_proc=1
      for entry in $MONITOR_PROCESSES; do
        proc_name="${entry%%:*}"
        metrics_file="$OUTPUT_DIR/runs/${run_num}.${proc_name}.metrics"

        if [ -f "$metrics_file" ]; then
          # Calculate mean CPU and memory from all samples in .metrics file
          # File format: timestamp cpu:value mem:value
          run_cpu=$(sed 's/.*cpu:\([0-9.]*\).*/\1/' "$metrics_file" | awk '{sum+=$1; count++} END {if(count>0) printf "%.2f", sum/count; else print "0"}')
          run_mem=$(sed 's/.*mem:\([0-9.]*\).*/\1/' "$metrics_file" | awk '{sum+=$1; count++} END {if(count>0) printf "%.2f", sum/count; else print "0"}')

          # Build JSON for this process
          if [ "$first_proc" -eq 1 ]; then
            first_proc=0
          else
            processes_json="$processes_json,"
          fi
          processes_json="$processes_json\"$proc_name\":{\"cpu_percent\":$run_cpu,\"memory_mb\":$run_mem}"
        fi
      done
    fi

    # -------------------------------------------------------------------------
    # Evidence, evaluation and validity (schema 2.1)
    #
    # Order matters and is what makes the distinction between failure classes
    # meaningful: a command that never met its exit requirement is not
    # "constraint_failed", and an evaluator is not asked to grade a run that
    # did not happen.
    # -------------------------------------------------------------------------

    # 1. Exit requirement
    if [ "$run_status" = "ok" ] && [ "$EXPECT_EXIT" != "any" ] \
       && [ "$cmd_exit" -ne "$EXPECT_EXIT" ]; then
      run_status="command_failed"
      run_error="command exited $cmd_exit (expected $EXPECT_EXIT)"
    fi

    # 2. Ingest whatever the command emitted.
    #    Done even for a failed command: measurements from a failed run are
    #    still evidence, and discarding them hides why it failed.
    ingest_err="$run_dir/.ingest.err"
    evidence_json='{"artifacts":[],"declared_valid":null,"evidence":[],"metrics":{},"units":{}}'
    run_metrics_tsv="$run_dir/.metrics.tsv"
    : > "$run_metrics_tsv"
    # Measurements are staged here and only folded into the global set once
    # this run's validity is known, so each observation can be tagged with it.
    run_measurements="$run_dir/.measurements.tsv"
    : > "$run_measurements"
    declared_valid=""
    if ingest_out=$(perl "$INGEST_PL" "$run_dir/result.json" "$run_dir/metrics.jsonl" \
                         "run $run_num" "$run_dir/metrics.json" 2>"$ingest_err"); then
      evidence_json=$(printf '%s\n' "$ingest_out" | sed -n 's/^JSON\t//p')
      printf '%s\n' "$ingest_out" | while IFS="$(printf '\t')" read -r kind a b c; do
        case "$kind" in
          METRIC)
            printf '%s\t%s\t%s\t%s\n' "$run_num" "$a" "$b" "$c" >> "$run_measurements"
            printf '%s\t%s\n' "$a" "$b" >> "$run_metrics_tsv"
            ;;
        esac
      done
      declared_valid=$(printf '%s\n' "$ingest_out" | sed -n 's/^VALID\t//p')
    else
      if [ "$run_status" = "ok" ]; then
        run_status="invalid_result"
        run_error=$(tr '\n' ';' < "$ingest_err" | sed 's/;$//; s/;/; /g')
      fi
    fi
    rm -f "$ingest_err"

    # 3. A subject may veto itself, but may not vouch for itself.
    #    "valid": true is recorded and otherwise ignored -- only an evaluator
    #    can establish validity.
    if [ "$run_status" = "ok" ] && [ "$declared_valid" = "0" ]; then
      run_status="declared_invalid"
      run_error="the command reported \"valid\": false"
    fi

    # 4. Independent evaluation
    evaluation_json="null"
    if [ -n "$EVALUATE_CMD" ] && [ "$run_status" = "ok" ]; then
      eval_stdout="$run_dir/evaluator.stdout"
      eval_stderr="$run_dir/evaluator.stderr"
      BENCH_RUN_DIR="$run_dir" \
      BENCH_RESULT_JSON="$run_dir/evaluation.json" \
      BENCH_METRICS="$run_dir/evaluation.jsonl" \
      BENCH_ARTIFACTS="$run_dir/artifacts" \
      BENCH_RUN_NUMBER="$run_num" \
      BENCH_EXIT_CODE="$cmd_exit" \
      BENCH_STDOUT="$stdout_file" \
      BENCH_STDERR="$stderr_file" \
        sh -c "$EVALUATE_CMD \"\$1\"" bench "$run_dir" \
          > "$eval_stdout" 2> "$eval_stderr"
      eval_exit=$?

      eval_valid="null"
      if [ "$eval_exit" -ne 0 ]; then
        run_status="evaluator_failed"
        run_error="evaluator exited $eval_exit"
      else
        eval_err="$run_dir/.eval.err"
        if eval_out=$(perl "$INGEST_PL" "$run_dir/evaluation.json" "$run_dir/evaluation.jsonl" \
                           "run $run_num evaluation" "$run_dir/evaluation.metrics.json" 2>"$eval_err"); then
          printf '%s\n' "$eval_out" | while IFS="$(printf '\t')" read -r kind a b c; do
            case "$kind" in
              METRIC)
                printf '%s\t%s\t%s\t%s\n' "$run_num" "$a" "$b" "$c" >> "$run_measurements"
                printf '%s\t%s\n' "$a" "$b" >> "$run_metrics_tsv"
                ;;
            esac
          done
          eval_declared=$(printf '%s\n' "$eval_out" | sed -n 's/^VALID\t//p')
          if [ "$eval_declared" = "0" ]; then
            eval_valid="false"
            run_status="evaluator_failed"
            run_error="evaluator reported \"valid\": false"
          elif [ "$eval_declared" = "1" ]; then
            eval_valid="true"
          fi
        else
          run_status="invalid_result"
          run_error=$(tr '\n' ';' < "$eval_err" | sed 's/;$//; s/;/; /g')
        fi
        rm -f "$eval_err"
      fi
      evaluation_json="{\"exit_code\":$eval_exit,\"valid\":$eval_valid}"
    fi

    # 5. Hard constraints and required artifacts
    if [ "$run_status" = "ok" ] && [ -n "$REQUIRE_FILE" ]; then
      while IFS= read -r constraint; do
        [ -n "$constraint" ] || continue
        check_constraint "$constraint" "$run_metrics_tsv"
        case $? in
          1)
            run_status="constraint_failed"
            run_error="constraint failed: $constraint"
            break
            ;;
          2)
            run_status="constraint_failed"
            run_error="constraint references a metric the run did not report: $constraint"
            break
            ;;
        esac
      done < "$REQUIRE_FILE"
    fi
    if [ "$run_status" = "ok" ] && [ -n "$REQUIRE_ARTIFACTS" ]; then
      printf '%s' "$REQUIRE_ARTIFACTS" | while IFS= read -r want; do
        [ -n "$want" ] || continue
        [ -e "$run_dir/$want" ] || [ -e "$run_dir/artifacts/$want" ] || exit 1
      done || {
        run_status="constraint_failed"
        run_error="a required artifact is missing"
      }
    fi
    rm -f "$run_metrics_tsv"

    run_valid_json=$([ "$run_status" = "ok" ] && echo "true" || echo "false")

    # Fold this run's measurements into the global set, tagged with validity
    run_valid_flag=$([ "$run_status" = "ok" ] && echo 1 || echo 0)
    if [ -s "$run_measurements" ]; then
      awk -F'\t' -v OFS='\t' -v v="$run_valid_flag" '{print $1, $2, $3, $4, v}' \
        "$run_measurements" >> "$MEASUREMENTS_FILE"
    fi
    rm -f "$run_measurements"
    run_error_json=$(json_escape "$run_error")

    # Store per-run data as JSON line
    processes_field=""
    if [ -n "$processes_json" ]; then
      processes_field=",\"processes\":{$processes_json}"
    fi
    # printf, not echo: dash's builtin echo interprets backslash escapes, which
    # would collapse the \\ that json_escape emits and produce invalid JSON.
    printf '%s\n' "{\"run_number\":$run_num,\"exit_code\":$cmd_exit,\"status\":\"$run_status\",\"valid\":$run_valid_json,\"error\":\"$run_error_json\",\"start\":\"$start_iso\",\"end\":\"$end_iso\",\"duration_seconds\":$duration_sec,\"duration_ms\":$duration_ms,\"stdout_bytes\":$stdout_bytes,\"stderr_bytes\":$stderr_bytes,\"evidence\":$evidence_json,\"evaluation\":$evaluation_json$processes_field}" >> "$RUNS_FILE"

    # The run is now fully recorded
    rm -f "$run_dir/INCOMPLETE"

    # Store results for statistics
    echo "$duration_ms" >> "$TIMES_FILE"
    echo "$cmd_exit" >> "$EXIT_CODES_FILE"

    run_hook "$CLEANUP_CMD" "$CLEANUP_SCOPE" run "cleanup"
    echo "$run_num" >> "$VARIANT_DONE_FILE"
  done < "$SCHEDULE_FILE"

  if [ "$QUIET" -eq 0 ]; then
    echo "" >&2
  fi

  # Re-enable exit on error
  set -e

  # ---------------------------------------------------------------------------
  # Finalize each variant
  #
  # Every variant produces a complete, standalone result directory, so an
  # experiment with variants is a directory of ordinary benchmark results
  # rather than a new format that tools have to learn.
  # ---------------------------------------------------------------------------
  printf '%s' "$VARIANT_NAMES" | grep . > "$VARIANT_WORK/finalize"
  while IFS= read -r variant_name; do
    [ -n "$variant_name" ] || continue
    CURRENT_VARIANT=""
    select_variant "$variant_name"

    # Counters come from the recorded runs rather than from the loop, so a
    # resumed or interleaved execution is counted the same way as a fresh one.
    run_hook "$CLEANUP_CMD" "$CLEANUP_SCOPE" variant "cleanup"
    tallies=$(derive_tallies "$RUNS_FILE")
    RUNS_COMPLETED=$(printf '%s\n' "$tallies" | sed -n 's/^RUNS_COMPLETED=//p')
    runs_valid=$(printf '%s\n' "$tallies" | sed -n 's/^runs_valid=//p')
    for st in ok command_failed invalid_result declared_invalid \
              evaluator_failed constraint_failed infrastructure_failed; do
      eval "status_${st}=$(printf '%s\n' "$tallies" | sed -n "s/^status_${st}=//p")"
    done

    # Calculate statistics
    runs_successful=0
    runs_failed=0
    while IFS= read -r code; do
      if [ "$code" -eq 0 ]; then
        runs_successful=$((runs_successful + 1))
      else
        runs_failed=$((runs_failed + 1))
      fi
    done < "$EXIT_CODES_FILE"

    # Calculate timing statistics
    if [ "$RUNS_COMPLETED" -gt 0 ]; then
      # Sort times for median/percentiles
      sorted_times=$(sort -n "$TIMES_FILE")

      # Min/Max
      time_min=$(echo "$sorted_times" | head -1)
      time_max=$(echo "$sorted_times" | tail -1)

      # Mean
      time_sum=$(awk '{sum+=$1} END {printf "%.6f", sum}' "$TIMES_FILE")
      time_mean=$(bc_normalize "scale=6; $time_sum / $RUNS_COMPLETED")

      # Median
      mid=$((RUNS_COMPLETED / 2))
      if [ $((RUNS_COMPLETED % 2)) -eq 0 ]; then
        val1=$(echo "$sorted_times" | sed -n "${mid}p")
        val2=$(echo "$sorted_times" | sed -n "$((mid + 1))p")
        time_median=$(bc_normalize "scale=6; ($val1 + $val2) / 2")
      else
        time_median=$(echo "$sorted_times" | sed -n "$((mid + 1))p")
      fi

      # Standard deviation (sample stddev with n-1 denominator)
      # Formula: sqrt(sum((x - mean)^2) / (n - 1))
      if [ "$RUNS_COMPLETED" -gt 1 ]; then
        sum_sq_diff=$(awk -v mean="$time_mean" '{diff=$1-mean; sum+=diff*diff} END {printf "%.6f", sum}' "$TIMES_FILE")
        time_stddev=$(bc_normalize "scale=6; sqrt($sum_sq_diff / ($RUNS_COMPLETED - 1))")
      else
        time_stddev=0
      fi

      # Percentiles using nearest rank method
      # Formula: rank = ceil(percentile * n)
      # p95
      p95_rank=$(echo "scale=0; ($RUNS_COMPLETED * 95 + 99) / 100" | bc)
      [ "$p95_rank" -gt "$RUNS_COMPLETED" ] && p95_rank=$RUNS_COMPLETED
      time_p95=$(echo "$sorted_times" | sed -n "${p95_rank}p")

      # p99
      p99_rank=$(echo "scale=0; ($RUNS_COMPLETED * 99 + 99) / 100" | bc)
      [ "$p99_rank" -gt "$RUNS_COMPLETED" ] && p99_rank=$RUNS_COMPLETED
      time_p99=$(echo "$sorted_times" | sed -n "${p99_rank}p")
    else
      time_min=0
      time_max=0
      time_mean=0
      time_median=0
      time_stddev=0
      time_p95=0
      time_p99=0
    fi

    # Calculate success rate
    if [ "$RUNS_COMPLETED" -gt 0 ]; then
      success_rate=$(bc_normalize "scale=2; $runs_successful * 100 / $RUNS_COMPLETED")
    else
      success_rate=0
    fi

    # Calculate aggregate process metrics if monitoring
    processes_json=""
    if [ -n "$MONITOR_PROCESSES" ]; then
      processes_json=",
    \"processes\": ["
      first_proc=1

      for entry in $MONITOR_PROCESSES; do
        proc_name="${entry%%:*}"
        rest="${entry#*:}"
        proc_pid="${rest%%:*}"
        proc_port="${rest#*:}"

        # Get initial memory from saved initial_metrics
        initial_mem=0
        for im in $initial_metrics; do
          im_name="${im%%:*}"
          im_mem="${im#*:}"
          if [ "$im_name" = "$proc_name" ]; then
            initial_mem="$im_mem"
            break
          fi
        done

        # Get final memory for leak detection
        final_stats=$(get_process_stats "$proc_pid")
        if [ -n "$final_stats" ]; then
          final_mem=$(echo "$final_stats" | awk '{print $2}')
        else
          final_mem="$initial_mem"
        fi
        mem_delta=$(bc_normalize "scale=2; $final_mem - $initial_mem")

        # Calculate CPU and memory stats from all .metrics files for this process
        # Concatenate all metrics files for this process across all runs
        all_metrics_file=$(mktemp)
        for metrics_file in "$OUTPUT_DIR/runs/"*."${proc_name}".metrics; do
          if [ -f "$metrics_file" ]; then
            cat "$metrics_file" >> "$all_metrics_file"
          fi
        done

        if [ -s "$all_metrics_file" ]; then
          # File format: timestamp cpu:value mem:value
          # Extract values using sed, then calculate stats
          cpu_values=$(sed 's/.*cpu:\([0-9.]*\).*/\1/' "$all_metrics_file")
          mem_values=$(sed 's/.*mem:\([0-9.]*\).*/\1/' "$all_metrics_file")

          cpu_mean=$(echo "$cpu_values" | awk '{sum+=$1; count++} END {if(count>0) printf "%.2f", sum/count; else print "0"}')
          cpu_min=$(echo "$cpu_values" | awk 'NR==1{min=$1} {if($1<min)min=$1} END{printf "%.2f", min}')
          cpu_max=$(echo "$cpu_values" | awk 'NR==1{max=$1} {if($1>max)max=$1} END{printf "%.2f", max}')

          mem_mean=$(echo "$mem_values" | awk '{sum+=$1; count++} END {if(count>0) printf "%.2f", sum/count; else print "0"}')
          mem_min=$(echo "$mem_values" | awk 'NR==1{min=$1} {if($1<min)min=$1} END{printf "%.2f", min}')
          mem_max=$(echo "$mem_values" | awk 'NR==1{max=$1} {if($1>max)max=$1} END{printf "%.2f", max}')
        else
          cpu_mean=0
          cpu_min=0
          cpu_max=0
          mem_mean=0
          mem_min=0
          mem_max=0
        fi
        rm -f "$all_metrics_file"

        # Add comma separator for subsequent entries
        if [ "$first_proc" -eq 1 ]; then
          first_proc=0
        else
          processes_json="$processes_json,"
        fi

        # Build port field only if port was specified
        port_field=""
        if [ -n "$proc_port" ]; then
          port_field="
        \"port\": $proc_port,"
        fi

        processes_json="$processes_json
      {
        \"name\": \"$proc_name\",
        \"pid\": $proc_pid,$port_field
        \"cpu\": {
          \"unit\": \"percent\",
          \"mean\": $cpu_mean,
          \"min\": $cpu_min,
          \"max\": $cpu_max
        },
        \"memory\": {
          \"unit\": \"megabytes\",
          \"mean\": $mem_mean,
          \"min\": $mem_min,
          \"max\": $mem_max,
          \"initial\": $initial_mem,
          \"final\": $final_mem,
          \"delta\": $mem_delta
        }
      }"
      done

      processes_json="$processes_json
    ]"
    fi

    # Aggregate raw per-run measurements into per-metric summaries.
    # A unit conflict across runs is fatal: it means two different quantities
    # were recorded under one name, and any summary of them would be wrong.
    metrics_json="{}"
    if [ -s "$MEASUREMENTS_FILE" ]; then
      agg_err=$(mktemp)
      if aggregated=$(perl "$AGGREGATE_PL" "$MEASUREMENTS_FILE" 2>"$agg_err"); then
        metrics_json="$aggregated"
        rm -f "$agg_err"
      else
        agg_msg=$(tr '\n' ';' < "$agg_err" | sed 's/;$//; s/;/; /g')
        rm -f "$agg_err"
        error "$agg_msg"
      fi
    fi

    runs_invalid=$((RUNS_COMPLETED - runs_valid))
    if [ "$RUNS_COMPLETED" -gt 0 ]; then
      valid_rate=$(bc_normalize "scale=2; $runs_valid * 100 / $RUNS_COMPLETED")
    else
      valid_rate=0
    fi

    # Escape every user-controlled string exactly once, here, rather than at
    # each interpolation site. Process names are already restricted to a
    # JSON-safe character set by sanitize_proc_name/validate_proc_name.
    name_json=$(json_escape "$NAME")
    message_json=$(json_escape "$MESSAGE")
    command_json=$(json_escape "$COMMAND")
    evaluate_json=$(json_escape "$EVALUATE_CMD")
    os_json=$(json_escape "$(uname -s)")
    shell_json=$(json_escape "$SHELL")
    pwd_json=$(json_escape "$PWD")

    # Splice the resume history into the provenance object captured at startup.
    # Done here rather than in the helper so the history survives a resume of a
    # resume: each sitting appends to what the previous one recorded.
    provenance_full=$(printf '%s' "$provenance_json" | sed 's/}$//')
    provenance_full="$provenance_full,\"resumes\":$resumes_json,\"finished\":\"$(get_iso_timestamp)\"}"

    # Generate JSON output.
    #
    # Written in three appends (header, runs array, tail) so the runs array is
    # streamed straight from the temp file. Accumulating it in a shell variable
    # re-copied the whole string once per run, which is quadratic in --runs.
    cat > "$OUTPUT_DIR/benchmark.json" << ENDJSON
{
  "schema_version": "$SCHEMA_VERSION",
  "tool": "bench",
  "tool_version": "$VERSION",
  "name": "$name_json",
  "message": "$message_json",
  "command": "$command_json",
  "runs_requested": $RUNS,
  "runs_completed": $RUNS_COMPLETED,
  "runs_successful": $runs_successful,
  "runs_failed": $runs_failed,
  "success_rate": $success_rate,
  "runs_valid": $runs_valid,
  "runs_invalid": $runs_invalid,
  "valid_rate": $valid_rate,
  "evaluator": "$evaluate_json",
  "expect_exit": "$EXPECT_EXIT",
  "validity": {
    "ok": $status_ok,
    "command_failed": $status_command_failed,
    "invalid_result": $status_invalid_result,
    "declared_invalid": $status_declared_invalid,
    "evaluator_failed": $status_evaluator_failed,
    "constraint_failed": $status_constraint_failed,
    "infrastructure_failed": $status_infrastructure_failed
  },
  "metrics": $metrics_json,
  "provenance": $provenance_full,
  "interrupted": $([ "$INTERRUPTED" -eq 1 ] && echo "true" || echo "false"),
  "timing": {
    "unit": "milliseconds",
    "min": $time_min,
    "max": $time_max,
    "mean": $time_mean,
    "median": $time_median,
    "stddev": $time_stddev,
    "p95": $time_p95,
    "p99": $time_p99
  },
  "environment": {
    "os": "$os_json",
    "shell": "$shell_json",
    "pwd": "$pwd_json"
  },
  "runs": [
ENDJSON

    # Stream the per-run objects (one JSON object per line in $RUNS_FILE)
    awk '{ if (NR > 1) printf ",\n"; printf "    %s", $0 }
         END { if (NR > 0) printf "\n" }' "$RUNS_FILE" >> "$OUTPUT_DIR/benchmark.json"

    cat >> "$OUTPUT_DIR/benchmark.json" << ENDJSON
  ]$processes_json
}
ENDJSON

    # Temp files are reclaimed by the EXIT trap once every variant is
    # finalized; calling cleanup here would delete the schedule and the
    # remaining variants' accumulators.

  done < "$VARIANT_WORK/finalize"

  # An experiment with variants also records how it was scheduled, so the
  # result explains the order its observations were taken in.
  if [ "$MULTI_VARIANT" -eq 1 ]; then
    write_experiment_json "$EXECUTION_DIR"
  fi
  run_hook "$CLEANUP_CMD" "$CLEANUP_SCOPE" experiment "cleanup"
  OUTPUT_DIR="$EXECUTION_DIR"


  # Output absolute path
  (cd "$OUTPUT_DIR" && pwd)

  # Exit with appropriate code
  if [ "$INTERRUPTED" -eq 1 ]; then
    exit 130
  fi
  exit 0
}

main "$@"
